def build_arg_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=PROG,
        description="Frame-accurate video cutter using only ffmpeg + ffprobe.",
        epilog=(
            "Examples:\n"
            "  ffcut video.mp4 10.250 130.750\n"
            "  ffcut video.mp4 00:10:23.456 00:12:34.567\n"
            "  ffcut video.mkv 01:20 end\n"
            "  ffcut video.mov -120 -10\n"
            "  ffcut video.mp4 10 60 --no-audio --no-subs\n"
            "  ffcut video.mp4 10 60 --no-video audio-clip.m4a\n"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("input", help="Source video file")
    parser.add_argument("start", help="Start time (seconds, HH:MM:SS(.ms), 'start', or negative-from-end)")
    parser.add_argument("end", nargs="?", default="end", help="End time (default: end of file)")
    parser.add_argument("output", nargs="?", default=None, help="Output path (default: '<name>_ffcut.<ext>')")

    parser.add_argument("--force", action="store_true", help="Overwrite an existing output file")
    parser.add_argument("--no-play", action="store_true", help="Do not open the result in mpv")
    parser.add_argument("--no-verify", action="store_true", help="Skip decode verification")
    parser.add_argument("--keep-temp", action="store_true", help="Keep temporary files")
    parser.add_argument("--ra-scan-limit", type=int, default=16, help="Max keyframes to check per side for a safe splice point")
    parser.add_argument("--provenance", choices=("embed", "beside", "folder", "none"), default=None,
                        help="Where jwkit records how the cut was made (needs jwkit's jwkit-provenance on PATH): inside the file, a .jwkit.json beside it, a separate folder, or nowhere. Default: jwkit's provenance_mode (embed)")
    parser.add_argument("--provenance-dir", default=None, help="Folder for --provenance folder (default: a hidden .jwkit folder beside the output)")

    parser.add_argument(
        "--start-sync", choices=START_SYNC_CHOICES, default="frame",
        help="How to line up audio with video when START falls between frames (the video begins on its next whole frame): "
             "'frame' (default) starts audio/subtitles/chapters on that frame too, so everything is in sync and the cut begins "
             "up to one frame after START; 'audio' keeps the audio at exactly START and delays the video by the gap (in sync, "
             "with a short empty lead-in on the video, stored as an MP4 edit list that some players ignore); 'off' leaves them "
             "unaligned, so the video runs early by up to one frame (the old behavior)",
    )
    parser.add_argument("--no-video", "-vn", action="store_true", help="Drop the video stream and extract only the other streams (like ffmpeg's -vn)")
    parser.add_argument("--no-audio", "-an", action="store_true", help="Drop all audio streams (like ffmpeg's -an)")
    parser.add_argument(
        "--exact-audio-copy",
        action="store_true",
        help=(
            "Preserve sample-exact stream-copied audio using preroll/edit-list metadata. "
            "Default drops negative preroll for better compatibility with players that "
            "mishandle MP4 edit lists (usually sacrificing less than one audio packet at the start)."
        ),
    )
    parser.add_argument("--no-subs", "-sn", action="store_true", help="Drop all subtitle streams (like ffmpeg's -sn)")
    parser.add_argument("--no-data", "-dn", action="store_true", help="Drop timed data streams (like ffmpeg's -dn)")
    parser.add_argument("--no-cover", action="store_true", help="Drop attached cover art")
    parser.add_argument("--no-attachments", action="store_true", help="Drop Matroska attachments (fonts, XML, etc.)")
    parser.add_argument("--no-chapters", action="store_true", help="Drop chapters")

    parser.add_argument("--h264-crf", type=int, default=18)
    parser.add_argument("--h264-preset", default="medium")
    parser.add_argument("--hevc-crf", type=int, default=20)
    parser.add_argument("--hevc-preset", default="medium")
    parser.add_argument("--av1-crf", type=int, default=23)
