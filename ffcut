def find_jwkit_provenance() -> Optional[str]:
    """jwkit's `jwkit-provenance`, on PATH or in a standard jwkit checkout."""
    found = shutil.which("jwkit-provenance")
    if found:
        return found
    for candidate in (Path.home() / "dig/jwkit/jwkit-provenance", Path.home() / "MyFiles/Digitalis/jwkit/jwkit-provenance"):
        if candidate.is_file():
            return str(candidate)
    return None


def record_provenance(opts: argparse.Namespace, input_path: Path, output_path: Path, start_sec: Decimal, end_sec: Decimal, **settings) -> None:
    """Optional: if jwkit is installed, record inside the output which source
    and time window it was cut from, how (stream copy vs re-encoded edges),
    and the exact command. Never fails the cut."""
    tool = find_jwkit_provenance()
    if tool is None:
        return
    settings.update({key: value for key, value in vars(opts).items()
                     if key.startswith(("no_", "start_sync", "h264_", "hevc_", "av1_", "vp9_", "vp8_", "mpeg", "prores_", "mjpeg_", "theora_", "exact_", "ra_"))
                     and value not in (False, None)})
    cmd = [tool, "record", str(output_path), "--tool", PROG, "--tool-file", str(Path(__file__).resolve()),
           "--source", str(input_path), "--window", f"{fmt_time(start_sec)}-{fmt_time(end_sec)}",
           "--command", shlex.join([PROG, *getattr(opts, "_argv", [])]),
           "--request", f"cwd={json.dumps(str(Path.cwd()))}", "--settings-json", json.dumps(settings, default=str)]
    for flag, key in (("--provenance", "provenance"), ("--provenance-dir", "provenance_dir")):
        if getattr(opts, key, None):
            cmd += [flag, str(getattr(opts, key))]
    try:
        subprocess.run(cmd, check=False, stdout=subprocess.DEVNULL)
    except OSError:
        pass


def run_ffcut(opts: argparse.Namespace) -> None:
    for tool in ("ffmpeg", "ffprobe"):
        if shutil.which(tool) is None:
            die(f"Required program not found: {tool}")

    input_path = Path(opts.input)
    if not input_path.is_file():
        die(f"File not found: {input_path}")

    output_path = Path(opts.output) if opts.output else default_output_path(input_path)
    if input_path.resolve() == output_path.resolve():
        die("Output must not overwrite input")
    out_dir = output_path.parent
    if not out_dir.is_dir():
        die(f"Output directory does not exist: {out_dir}")
    if output_path.exists() and not opts.force:
        die(f"Output already exists: {output_path} (pass --force to overwrite)")

    if opts.no_video:
        if opts.no_audio and opts.no_subs and opts.no_data:
            die("--no-video combined with --no-audio, --no-subs, and --no-data would leave nothing to cut")
        _run_no_video_cut(opts, input_path, output_path, out_dir)
    else:
        _run_video_cut(opts, input_path, output_path, out_dir)


def _run_video_cut(opts: argparse.Namespace, input_path: Path, output_path: Path, out_dir: Path) -> None:
    probe = probe_primary_video(input_path)
    streams = probe.get("streams") or []
    if not streams:
        die("Could not determine primary video codec")
    vstream = streams[0]
    fmt = probe.get("format") or {}

    duration_raw = vstream.get("duration") or fmt.get("duration")
    if not duration_raw or duration_raw == "N/A":
        die("Could not determine source duration")
    src_duration = Decimal(duration_raw)

    start_time_raw = fmt.get("start_time")
    src_start_time = Decimal(start_time_raw) if start_time_raw and start_time_raw != "N/A" else Decimal(0)

    start_sec, end_sec, cut_duration = resolve_cut_window(opts.start, opts.end, src_duration)

    if normal_video_count(input_path) != 1:
        die(f"Expected exactly one normal video stream; found {normal_video_count(input_path)}")

    codec = vstream.get("codec_name")
    if not codec:
        die("Could not determine primary video codec")

    profile = build_codec_profile(codec, opts)
    if not encoder_exists(profile.encoder):
        die(f"FFmpeg encoder not available: {profile.encoder}")

    smart_capable = profile.smart_capable
    if smart_capable:
        if not (bsf_exists("noise") and bsf_exists("setts")):
            smart_capable = False
        if codec == "h264" and not bsf_exists("h264_mp4toannexb"):
            smart_capable = False
        if codec == "hevc" and not bsf_exists("hevc_mp4toannexb"):
            smart_capable = False

    exact_audio_copy = opts.exact_audio_copy
    if not opts.no_audio and not exact_audio_copy and not bsf_exists("noise"):
        warn("FFmpeg 'noise' bitstream filter is unavailable; preserving exact audio preroll/edit-list behavior.")
        exact_audio_copy = True

    ctx = Context(
        input=input_path,
        codec=codec,
        profile=profile,
        smart_capable=smart_capable,
        video_props=video_props_args(vstream),
        src_duration=src_duration,
        src_start_time=src_start_time,
        v_index=vstream.get("index"),
        codec_tag=vstream.get("codec_tag_string") or "",
        time_base=vstream.get("time_base") or "",
        rotation=video_rotation(vstream),
        exact_audio_copy=exact_audio_copy,
    )

    tmpdir = Path(tempfile.mkdtemp(dir=out_dir, prefix=f".{PROG}."))
    old_handlers = {}
    for sig_name in ("SIGTERM", "SIGHUP"):
        sig = getattr(signal, sig_name, None)
        if sig is not None:
            old_handlers[sig] = signal.getsignal(sig)
            signal.signal(sig, _handle_terminating_signal)

    try:
        k_start, k_end = find_splice_points(ctx, start_sec, end_sec, opts.ra_scan_limit)
        can_smart = k_start is not None and k_end is not None and k_end > k_start

        smart_used = False
        if can_smart:
            info(f"Smart cut: {codec}  {fmt_time(start_sec)}s -> {fmt_time(end_sec)}s")
            info(f"Safe splice points: {fmt_time(k_start)}s .. {fmt_time(k_end)}s")
            hybrid = smart_render(ctx, start_sec, end_sec, k_start, k_end, tmpdir)
            smart_used = True
        else:
            if smart_capable:
                if codec == "hevc":
                    warn("No safe HEVC IDR/BLA splice pair found; CRA/open-GOP video will not be spliced blindly.")
                else:
                    warn("No safe splice pair found.")
            else:
                warn(f"{codec} is not smart-spliced by this script.")
            warn("Encoding only the requested video segment instead.")
            hybrid = tmpdir / f"hybrid.{profile.intermediate_ext}"
            encode_segment(ctx, start_sec, end_sec, hybrid)

        if not hybrid.exists() or hybrid.stat().st_size == 0:
            die("Video stage produced no output")

        if not opts.no_verify:
            info("Verifying video decode...")
            if not verify_decode(hybrid):
                if smart_used:
                    warn("Smart splice failed verification; falling back to full requested-video encode.")
                    hybrid.unlink(missing_ok=True)
                    encode_segment(ctx, start_sec, end_sec, hybrid)
                    if not verify_decode(hybrid):
                        die("Fallback video encode failed verification")
                    smart_used = False
                else:
                    die("Encoded video failed verification")

        aux_start, video_offset = resolve_start_sync(ctx, opts.start_sync, start_sec, end_sec)
        aux_duration = end_sec - aux_start
        chapters_meta = None if opts.no_chapters else build_chapters_meta(input_path, tmpdir, aux_start, end_sec)

        # Final mux
        input_probe = probe_all_streams(input_path)
        out_ext_lc = output_path.suffix.lstrip(".").lower()
        final_tmp = tmpdir / f"final{output_path.suffix}"
        drop = DropOpts(
            audio=opts.no_audio,
            subs=opts.no_subs,
            data=opts.no_data,
            cover=opts.no_cover,
            attachments=opts.no_attachments,
        )
        mux_cmd = build_final_mux_cmd(ctx, input_probe, hybrid, aux_start, aux_duration, chapters_meta, out_ext_lc, final_tmp, drop, video_offset)
        run_ffmpeg(mux_cmd)

        if not final_tmp.exists() or final_tmp.stat().st_size == 0:
            die("Final mux produced no output")

        # Verify important stream preservation
        output_probe = probe_all_streams(final_tmp)
        out_streams = output_probe.get("streams") or []
        out_video = next((s for s in out_streams if s.get("codec_type") == "video" and not is_attached_pic(s)), {})
        out_codec = out_video.get("codec_name")
        if out_codec != codec:
            die(f"Primary video codec changed unexpectedly: {codec} -> {out_codec or 'unknown'}")

        verify_aux_streams(opts, input_probe, output_probe)

        final_tmp.replace(output_path)
        record_provenance(opts, input_path, output_path, start_sec, end_sec, video_codec=codec, smart_cut=smart_used)

        if smart_used:
            info(f"Done (smart cut): {output_path}")
        else:
            info(f"Done (requested video segment encoded): {output_path}")
        info(f"Codec: {codec} | {fmt_time(start_sec)}s -> {fmt_time(end_sec)}s ({fmt_time(cut_duration)}s requested)")

        if not opts.no_play and shutil.which("mpv"):
            subprocess.run(["mpv", "--keep-open", "--fullscreen", str(output_path)])
    finally:
        for sig, handler in old_handlers.items():
            signal.signal(sig, handler)
        if opts.keep_temp:
            info(f"Temporary files kept: {tmpdir}")
        else:
            shutil.rmtree(tmpdir, ignore_errors=True)


def _run_no_video_cut(opts: argparse.Namespace, input_path: Path, output_path: Path, out_dir: Path) -> None:
    input_probe = probe_all_streams(input_path)
    fmt = input_probe.get("format") or {}
    duration_raw = fmt.get("duration")
    if not duration_raw or duration_raw == "N/A":
        die("Could not determine source duration")
    src_duration = Decimal(duration_raw)

    start_sec, end_sec, cut_duration = resolve_cut_window(opts.start, opts.end, src_duration)

    tmpdir = Path(tempfile.mkdtemp(dir=out_dir, prefix=f".{PROG}."))
    old_handlers = {}
    for sig_name in ("SIGTERM", "SIGHUP"):
        sig = getattr(signal, sig_name, None)
        if sig is not None:
            old_handlers[sig] = signal.getsignal(sig)
            signal.signal(sig, _handle_terminating_signal)

    try:
        chapters_meta = None if opts.no_chapters else build_chapters_meta(input_path, tmpdir, start_sec, end_sec)

        out_ext_lc = output_path.suffix.lstrip(".").lower()
        final_tmp = tmpdir / f"final{output_path.suffix}"
        drop = DropOpts(
            audio=opts.no_audio,
            subs=opts.no_subs,
            data=opts.no_data,
            cover=True,
            attachments=opts.no_attachments,
        )
        exact_audio_copy = opts.exact_audio_copy
        if not opts.no_audio and not exact_audio_copy and not bsf_exists("noise"):
            warn("FFmpeg 'noise' bitstream filter is unavailable; preserving exact audio preroll/edit-list behavior.")
            exact_audio_copy = True
        mux_cmd = build_no_video_mux_cmd(
            input_path, input_probe, start_sec, cut_duration, chapters_meta,
            out_ext_lc, final_tmp, drop, exact_audio_copy=exact_audio_copy
        )
        run_ffmpeg(mux_cmd)

        if not final_tmp.exists() or final_tmp.stat().st_size == 0:
            die("Final mux produced no output")

        output_probe = probe_all_streams(final_tmp)
        verify_aux_streams(opts, input_probe, output_probe)

        final_tmp.replace(output_path)
        record_provenance(opts, input_path, output_path, start_sec, end_sec, video_dropped=True)

        info(f"Done (video dropped): {output_path}")
        info(f"{fmt_time(start_sec)}s -> {fmt_time(end_sec)}s ({fmt_time(cut_duration)}s requested)")

        if not opts.no_play and shutil.which("mpv"):
            subprocess.run(["mpv", "--keep-open", str(output_path)])
    finally:
        for sig, handler in old_handlers.items():
            signal.signal(sig, handler)
        if opts.keep_temp:
            info(f"Temporary files kept: {tmpdir}")
        else:
            shutil.rmtree(tmpdir, ignore_errors=True)


def main(argv: Optional[list[str]] = None) -> int:
    parser = build_arg_parser()
    opts = parser.parse_args(argv)
    opts._argv = list(sys.argv[1:] if argv is None else argv)
    try:
        run_ffcut(opts)
    except FfcutError as exc:
        print(f"{PROG}: {exc}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print(f"{PROG}: interrupted", file=sys.stderr)
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main())
