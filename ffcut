@dataclass
class DropOpts:
    """Which auxiliary stream categories to omit from the output, mirroring
    ffmpeg's -an/-sn/-dn but broken out per category (including ones ffmpeg
    has no single flag for, like cover art or Matroska attachments)."""

    audio: bool = False
    subs: bool = False
    data: bool = False
    cover: bool = False
    attachments: bool = False


def build_final_mux_cmd(
    ctx: Context,
    input_probe: dict,
    hybrid: Path,
    start_sec: Decimal,
    cut_duration: Decimal,
    chapters_meta: Optional[Path],
    out_ext_lc: str,
    final_tmp: Path,
    drop: Optional[DropOpts] = None,
    video_offset: Decimal = Decimal(0),
) -> list[str]:
    drop = drop or DropOpts()
    cmd = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-stats", "-y"]

    if ctx.rotation != 0:
        cmd += ["-display_rotation:v:0", str(ctx.rotation)]

    if video_offset > 0:
        cmd += ["-itsoffset", fmt_time(video_offset)]
    cmd += ["-i", str(hybrid)]
    cmd += ["-ss", fmt_time(start_sec), "-i", str(ctx.input)]
    cmd += ["-i", str(ctx.input)]

    chapter_input = -1
    if chapters_meta is not None:
        chapter_input = 3
        cmd += ["-f", "ffmetadata", "-i", str(chapters_meta)]

    # Main video, plus audio/subtitles unless dropped
    cmd += ["-map", "0:v:0"]
    if not drop.audio:
        cmd += ["-map", "1:a?"]
    if not drop.subs:
        cmd += ["-map", "1:s?"]

    # Timed data streams (excluding the regenerated MP4 chapter track)
    if not drop.data:
        for idx in data_stream_indexes_to_copy(input_probe):
            cmd += ["-map", f"1:{idx}"]

    # Cover artwork
    covers = [] if drop.cover else cover_streams(input_probe)
    for stream in covers:
        cmd += ["-map", f"2:{stream['index']}"]

    # Matroska attachments: fonts, XML, artwork, etc.
    if not drop.attachments:
        cmd += ["-map", "2:t?"]

    cmd += ["-copy_unknown", "-map_metadata", "2"]
    if ctx.v_index is not None:
        cmd += ["-map_metadata:s:v:0", f"2:s:{ctx.v_index}"]
    cmd += passthrough_stream_metadata(input_probe, 1, drop)

    cmd += ["-map_chapters", str(chapter_input) if chapter_input >= 0 else "-1"]
    cmd += ["-c", "copy"]

    # Restore attached_pic disposition (covers land after data streams)
    for i in range(1, len(covers) + 1):
        cmd += [f"-disposition:v:{i}", "attached_pic"]

    # Input-side -ss on a multiplexed file may seek via a video keyframe.
    # Stream-copied audio can therefore arrive with a large negative preroll
    # and rely on MP4 edit-list / Skip Samples metadata for exact trimming.
    # Some players mishandle that metadata and play the preroll, causing an
    # obvious A/V offset.  By default, drop only negative audio packets.  This
    # keeps the encoded audio bitstream untouched and trades sample-exactness
    # at the very first packet for broad player compatibility (normally <= one
    # encoded audio packet).  --exact-audio-copy restores the old behavior.
    if not drop.audio and not ctx.exact_audio_copy:
        cmd += ["-bsf:a", "noise=drop='lt(pts,0)'"]

    # Bound copied auxiliary streams to the requested output length.
    cmd += ["-t", fmt_time(cut_duration)]

    if out_ext_lc in MP4_LIKE_EXTS:
        if ctx.codec_tag and ctx.codec_tag not in ("", "[0][0][0][0]"):
            cmd += ["-tag:v:0", ctx.codec_tag]
        if ctx.time_base.startswith("1/"):
            ts = ctx.time_base[2:]
            if ts.isdigit():
                cmd += ["-video_track_timescale", ts]
        cmd += ["-use_editlist", "1", "-movflags", "+faststart"]
    elif out_ext_lc in MKV_LIKE_EXTS:
        cmd += ["-default_mode", "infer_no_subs"]

    cmd += [str(final_tmp)]
    return cmd


def build_no_video_mux_cmd(
    input_path: Path,
    input_probe: dict,
    start_sec: Decimal,
    cut_duration: Decimal,
    chapters_meta: Optional[Path],
    out_ext_lc: str,
    final_tmp: Path,
    drop: DropOpts,
    exact_audio_copy: bool = False,
) -> list[str]:
    """Extract only the non-video streams. There's no GOP to splice around
    without a video stream, so this is just a seek + stream-copy of the
    original file, bounded to the requested window."""
    cmd = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-stats", "-y"]
    cmd += ["-ss", fmt_time(start_sec), "-i", str(input_path)]
    cmd += ["-i", str(input_path)]

    chapter_input = -1
    if chapters_meta is not None:
        chapter_input = 2
        cmd += ["-f", "ffmetadata", "-i", str(chapters_meta)]

    if not drop.audio:
        cmd += ["-map", "0:a?"]
    if not drop.subs:
        cmd += ["-map", "0:s?"]
    if not drop.data:
        for idx in data_stream_indexes_to_copy(input_probe):
            cmd += ["-map", f"0:{idx}"]
    if not drop.attachments:
        cmd += ["-map", "1:t?"]

    cmd += ["-copy_unknown", "-map_metadata", "1"]
    cmd += passthrough_stream_metadata(input_probe, 0, drop)
    cmd += ["-map_chapters", str(chapter_input) if chapter_input >= 0 else "-1"]
    cmd += ["-c", "copy"]

    # See build_final_mux_cmd(): avoid large negative audio preroll by
    # default when doing a stream-copy cut.
    if not drop.audio and not exact_audio_copy:
        cmd += ["-bsf:a", "noise=drop='lt(pts,0)'"]

    # Bound copied streams to the requested output length.
    cmd += ["-t", fmt_time(cut_duration)]

    if out_ext_lc in MP4_LIKE_EXTS:
        cmd += ["-movflags", "+faststart"]
    elif out_ext_lc in MKV_LIKE_EXTS:
        cmd += ["-default_mode", "infer_no_subs"]

    cmd += [str(final_tmp)]
    return cmd


def verify_aux_streams(opts: argparse.Namespace, input_probe: dict, output_probe: dict) -> None:
    """Check that whatever wasn't explicitly dropped survived the final mux
    intact, and that whatever was explicitly dropped is actually gone."""
    if opts.no_audio:
        if audio_codec_list(output_probe):
            die("--no-audio was requested but the output still has audio streams")
    elif audio_codec_list(input_probe) != audio_codec_list(output_probe):
        die("An 'a' stream was lost or changed codec during final mux")

    if opts.no_subs:
        if subtitle_codec_list(output_probe):
            die("--no-subs was requested but the output still has subtitle streams")
    elif subtitle_codec_list(input_probe) != subtitle_codec_list(output_probe):
        die("An 's' stream was lost or changed codec during final mux")

    if opts.no_cover or opts.no_video:
        if cover_codec_list(output_probe):
            die("Cover artwork was requested to be dropped but the output still has it")
    elif cover_codec_list(input_probe) != cover_codec_list(output_probe):
        die("Attached cover artwork was lost or changed")

    if opts.no_data:
        if nonchapter_data_count(output_probe):
            die("--no-data was requested but the output still has data streams")
    else:
        in_data_count = nonchapter_data_count(input_probe)
        out_data_count = nonchapter_data_count(output_probe)
        if in_data_count != out_data_count:
            # Not fatal: a timed data stream (GoPro telemetry, timecode,
            # etc.) can legitimately have zero packets inside the requested
            # window and be dropped by the muxer - that's correct behavior,
            # not lost data.
            warn(f"Timed data stream count changed: {in_data_count} -> {out_data_count} (no packets in the cut range?)")

    if opts.no_attachments:
        if attachment_count(output_probe):
            die("--no-attachments was requested but the output still has attachments")
    elif attachment_count(input_probe) != attachment_count(output_probe):
        die(f"Attachment count changed: {attachment_count(input_probe)} -> {attachment_count(output_probe)}")


