#!/usr/bin/env python3
"""ffcut: frame-accurate video cutter using only ffmpeg + ffprobe.

Where safe:
    start partial GOP  -> re-encode
    middle GOPs        -> stream-copy
    end partial GOP    -> re-encode

If a safe splice cannot be established, only the requested VIDEO segment is
re-encoded. Audio/subtitles/data/etc. are still stream-copied.

Smart splice codecs:
    H.264 / AVC
    H.265 / HEVC   (IDR/BLA closed-GOP boundaries only; CRA/open-GOP is
                    intentionally rejected and falls back to a re-encode)
    AV1
    VP9
    VP8

Other supported video codecs are cut exactly by re-encoding the requested
video segment, while other streams are still copied.

Containers: MP4, M4V, MOV, MKV, WebM, TS, M2TS, etc., subject to FFmpeg
muxer support.

Audio compatibility:
    Audio remains stream-copied. By default, negative seek-preroll packets are
    dropped so cuts do not depend on player support for long MP4 edit-list /
    Skip Samples preroll. This can move the audio start by less than one encoded
    audio packet. Use --exact-audio-copy to keep the old sample-exact metadata-
    based behavior when the target players are known to handle it correctly.
"""

from __future__ import annotations

import argparse
import json
import re
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
from dataclasses import dataclass, field
from decimal import ROUND_HALF_UP, Decimal, InvalidOperation, getcontext
from pathlib import Path
from typing import Optional

getcontext().prec = 40

PROG = "ffcut"

NINE_PLACES = Decimal("0.000000001")
EQ_EPSILON = Decimal("0.0005")
K_SEARCH_EPSILON = Decimal("0.0005")
EOF_GRACE = Decimal("0.250")
NUDGE = Decimal("0.000001")
SEEK_LEAD = Decimal("0.001")  # how far before a segment's first frame its re-encode seeks

MP4_LIKE_EXTS = {"mp4", "m4v", "mov", "3gp", "3g2", "mj2", "m4a"}
MKV_LIKE_EXTS = {"mkv", "mka", "mks", "webm"}


class FfcutError(Exception):
    """Raised for any condition that should abort the run with a message."""


def die(msg: str) -> None:
    raise FfcutError(msg)


def warn(msg: str) -> None:
    print(f"{PROG}: WARNING: {msg}", file=sys.stderr)


def info(msg: str) -> None:
    print(f"{PROG}: {msg}", file=sys.stderr)


def fmt_time(value: Decimal) -> str:
    # str(Decimal) uses scientific notation for e.g. 0 ("0E-9"), which
    # ffmpeg/ffprobe won't parse as a time - force fixed-point notation.
    return format(value.quantize(NINE_PLACES), "f")


def flt_eq(a: Decimal, b: Decimal, epsilon: Decimal = EQ_EPSILON) -> bool:
    return abs(a - b) <= epsilon


###############################################################################
# Subprocess handling (tracks the in-flight ffmpeg/ffprobe process so a
# SIGTERM/SIGHUP can stop it too, not just the Python process).

_current_proc: Optional[subprocess.Popen] = None


def _popen(cmd: list[str], cwd: Optional[Path], capture: bool) -> subprocess.CompletedProcess:
    global _current_proc
    proc = subprocess.Popen(
        cmd,
        cwd=str(cwd) if cwd else None,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
        text=True,
    )
    _current_proc = proc
    try:
        stdout, stderr = proc.communicate()
    finally:
        _current_proc = None
    return subprocess.CompletedProcess(cmd, proc.returncode, stdout, stderr)


def _handle_terminating_signal(signum: int, _frame) -> None:
    if _current_proc is not None and _current_proc.poll() is None:
        _current_proc.terminate()
    raise SystemExit(128 + signum)


def run_ffmpeg(cmd: list[str], cwd: Optional[Path] = None) -> None:
    """Run an ffmpeg/ffprobe command with output streamed to the terminal."""
    result = _popen(cmd, cwd=cwd, capture=False)
    if result.returncode != 0:
        die(f"Command failed ({result.returncode}): {' '.join(cmd)}")


def run_captured(cmd: list[str]) -> subprocess.CompletedProcess:
    return _popen(cmd, cwd=None, capture=True)


###############################################################################
# ffprobe helpers (pure-ish: take a path, return plain dict/list data)


def ffprobe_json(path: Path, *args: str) -> dict:
    cmd = ["ffprobe", "-v", "error", "-print_format", "json", *args, str(path)]
    result = run_captured(cmd)
    if result.returncode != 0:
        return {}
    try:
        return json.loads(result.stdout or "{}")
    except json.JSONDecodeError:
        return {}


def probe_primary_video(path: Path) -> dict:
    """Single combined ffprobe call for the primary video stream + format."""
    return ffprobe_json(path, "-select_streams", "V:0", "-show_streams", "-show_format")


def probe_all_streams(path: Path) -> dict:
    """Single combined ffprobe call for every stream + format in the file."""
    return ffprobe_json(path, "-show_streams", "-show_format")


def normal_video_count(path: Path) -> int:
    data = ffprobe_json(path, "-select_streams", "V", "-show_entries", "stream=index")
    return len(data.get("streams") or [])


def streams_by_type(probe: dict, codec_type: str) -> list[dict]:
    return [s for s in probe.get("streams") or [] if s.get("codec_type") == codec_type]


def is_attached_pic(stream: dict) -> bool:
    return stream.get("codec_type") == "video" and (stream.get("disposition") or {}).get("attached_pic") == 1


def cover_streams(probe: dict) -> list[dict]:
    return [s for s in streams_by_type(probe, "video") if is_attached_pic(s)]


def cover_codec_list(probe: dict) -> list[str]:
    return sorted(s.get("codec_name", "") for s in cover_streams(probe))


def audio_codec_list(probe: dict) -> list[str]:
    return sorted(s.get("codec_name", "") for s in streams_by_type(probe, "audio"))


def subtitle_codec_list(probe: dict) -> list[str]:
    return sorted(s.get("codec_name", "") for s in streams_by_type(probe, "subtitle"))


def attachment_count(probe: dict) -> int:
    return len(streams_by_type(probe, "attachment"))


def passthrough_stream_metadata(probe: dict, input_index: int, drop: "DropOpts") -> list[str]:
    """Carry each kept audio/subtitle stream's own tags (language, title)
    across. Once -map_metadata names a global source, ffmpeg stops copying
    per-stream tags, so a cut file lost e.g. 'tgl' (Tagalog audio) and 'eng'
    (English subs) and showed 'und'."""
    args: list[str] = []
    for kind, dropped, spec in (("audio", drop.audio, "a"), ("subtitle", drop.subs, "s")):
        if dropped:
            continue
        for n, _ in enumerate(streams_by_type(probe, kind)):
            args += [f"-map_metadata:s:{spec}:{n}", f"{input_index}:s:{spec}:{n}"]
    return args


def data_stream_indexes_to_copy(probe: dict) -> list[int]:
    """MP4 chapter tracks are regenerated from chapter metadata, not copied."""
    indexes = []
    for s in streams_by_type(probe, "data"):
        codec = s.get("codec_name")
        tag = s.get("codec_tag_string")
        handler = (s.get("tags") or {}).get("handler_name")
        if codec == "bin_data" and tag == "text" and handler == "SubtitleHandler":
            continue
        idx = s.get("index")
        if idx is not None:
            indexes.append(idx)
    return indexes


def nonchapter_data_count(probe: dict) -> int:
    return len(data_stream_indexes_to_copy(probe))


def video_rotation(stream: dict) -> Decimal:
    for side_data in stream.get("side_data_list") or []:
        if "rotation" in side_data:
            try:
                return Decimal(str(side_data["rotation"]))
            except InvalidOperation:
                pass
    return Decimal(0)


def encoder_exists(name: str) -> bool:
    result = run_captured(["ffmpeg", "-hide_banner", "-encoders"])
    return bool(re.search(rf"\s{re.escape(name)}\s", result.stdout or ""))


def bsf_exists(name: str) -> bool:
    result = run_captured(["ffmpeg", "-hide_banner", "-bsfs"])
    return name in (result.stdout or "").splitlines()


###############################################################################
# Time handling


def time_to_seconds(raw: str) -> Decimal:
    text = raw.strip()
    sign = Decimal(1)
    if text.startswith("-"):
        sign = Decimal(-1)
        text = text[1:]
    parts = text.split(":")
    if not 1 <= len(parts) <= 3:
        raise ValueError(f"Invalid time: {raw}")
    try:
        nums = [Decimal(p) for p in parts]
    except InvalidOperation as exc:
        raise ValueError(f"Invalid time: {raw}") from exc
    total = Decimal(0)
    for n in nums:
        total = total * 60 + n
    return sign * total


def resolve_time(raw: str, duration: Decimal) -> Decimal:
    low = raw.strip().lower()
    if low in ("start", "s"):
        return Decimal(0)
    if low in ("end", "e"):
        return duration
    seconds = time_to_seconds(raw)
    if seconds < 0:
        seconds = duration + seconds
    return seconds


def resolve_cut_window(raw_start: str, raw_end: str, src_duration: Decimal) -> tuple[Decimal, Decimal, Decimal]:
    """Resolve and validate the [start, end) window, snapping an END that
    lands just past EOF back to the exact duration. Returns (start, end,
    end - start)."""
    try:
        start_sec = resolve_time(raw_start, src_duration)
    except ValueError:
        die(f"Invalid start time: {raw_start}")
    try:
        end_sec = resolve_time(raw_end, src_duration)
    except ValueError:
        die(f"Invalid end time: {raw_end}")

    if start_sec < 0:
        die("Start is before beginning of file")
    if end_sec <= start_sec:
        die("End must be after start")
    if start_sec > src_duration:
        die("Start is past EOF")
    if end_sec > src_duration:
        if end_sec <= src_duration + EOF_GRACE:
            end_sec = src_duration
        else:
            die(f"End is past EOF ({src_duration}s)")

    return start_sec, end_sec, end_sec - start_sec


###############################################################################
# Chapters


@dataclass
class ChapterBlock:
    timebase: str
    start: Decimal
    end: Decimal
    tags: list[str] = field(default_factory=list)


def parse_ffmetadata_chapters(text: str) -> list[ChapterBlock]:
    chapters: list[ChapterBlock] = []
    in_chapter = False
    timebase = "1/1000"
    start: Optional[Decimal] = None
    end: Optional[Decimal] = None
    tags: list[str] = []

    def flush() -> None:
        nonlocal in_chapter, timebase, start, end, tags
        if in_chapter and start is not None and end is not None:
            chapters.append(ChapterBlock(timebase, start, end, tags[:]))
        timebase = "1/1000"
        start = None
        end = None
        tags = []

    for line in text.splitlines():
        if line == "[CHAPTER]":
            flush()
            in_chapter = True
            continue
        if line.startswith("[") and line != "[CHAPTER]":
            flush()
            in_chapter = False
            continue
        if not in_chapter:
            continue
        if line.startswith("TIMEBASE="):
            timebase = line[len("TIMEBASE="):]
        elif line.startswith("START="):
            try:
                start = Decimal(line[len("START="):])
            except InvalidOperation:
                start = None
        elif line.startswith("END="):
            try:
                end = Decimal(line[len("END="):])
            except InvalidOperation:
                end = None
        else:
            tags.append(line)
    flush()
    return chapters


def trim_chapters(chapters: list[ChapterBlock], cut_start: Decimal, cut_end: Decimal) -> list[ChapterBlock]:
    """Keep only the portion of each chapter that overlaps [cut_start, cut_end),
    rebased so the new timeline starts at zero."""
    result: list[ChapterBlock] = []
    for chapter in chapters:
        try:
            num_str, den_str = chapter.timebase.split("/")
            num, den = Decimal(num_str), Decimal(den_str)
        except (ValueError, InvalidOperation):
            continue
        if num <= 0 or den <= 0:
            continue
        tick = num / den

        seg_start = chapter.start * tick
        seg_end = chapter.end * tick
        overlap_start = max(seg_start, cut_start)
        overlap_end = min(seg_end, cut_end)
        if overlap_end <= overlap_start:
            continue

        new_start_ticks = (overlap_start - cut_start) / tick
        new_end_ticks = (overlap_end - cut_start) / tick
        result.append(
            ChapterBlock(
                chapter.timebase,
                new_start_ticks.to_integral_value(rounding=ROUND_HALF_UP),
                new_end_ticks.to_integral_value(rounding=ROUND_HALF_UP),
                chapter.tags,
            )
        )
    return result


def render_ffmetadata_chapters(chapters: list[ChapterBlock]) -> str:
    lines = [";FFMETADATA1"]
    for chapter in chapters:
        lines.append("[CHAPTER]")
        lines.append(f"TIMEBASE={chapter.timebase}")
        lines.append(f"START={int(chapter.start)}")
        lines.append(f"END={int(chapter.end)}")
        lines.extend(chapter.tags)
    return "\n".join(lines) + "\n"


def build_chapters_meta(input_path: Path, tmpdir: Path, start_sec: Decimal, end_sec: Decimal) -> Optional[Path]:
    """Extract the source's chapters, trim/rebase them to [start_sec, end_sec),
    and write them back out as an ffmetadata file - or return None if nothing
    survives the cut."""
    raw_meta = tmpdir / "source.ffmeta"
    run_ffmpeg(["ffmpeg", "-hide_banner", "-loglevel", "error", "-y", "-i", str(input_path), "-f", "ffmetadata", str(raw_meta)])
    chapters = trim_chapters(parse_ffmetadata_chapters(raw_meta.read_text(encoding="utf-8")), start_sec, end_sec)
    if not chapters:
        return None
    chapters_meta = tmpdir / "chapters.ffmeta"
    chapters_meta.write_text(render_ffmetadata_chapters(chapters), encoding="utf-8")
    return chapters_meta


###############################################################################
# Codec profile selection


@dataclass
class CodecProfile:
    smart_capable: bool
    intermediate_ext: str
    encoder: str
    enc_args: list[str]


def build_codec_profile(codec: str, opts: argparse.Namespace) -> CodecProfile:
    if codec == "h264":
        return CodecProfile(True, "ts", "libx264", [
            "-preset", opts.h264_preset, "-crf", str(opts.h264_crf),
            "-x264-params", "open-gop=0:repeat-headers=1",
        ])
    if codec == "hevc":
        return CodecProfile(True, "ts", "libx265", [
            "-preset", opts.hevc_preset, "-crf", str(opts.hevc_crf),
            "-x265-params", "open-gop=0:repeat-headers=1",
        ])
    if codec == "av1":
        return CodecProfile(True, "mkv", "libsvtav1", [
            "-preset", str(opts.av1_preset), "-crf", str(opts.av1_crf),
        ])
    if codec == "vp9":
        return CodecProfile(True, "mkv", "libvpx-vp9", [
            "-deadline", "good", "-cpu-used", str(opts.vp9_cpu_used),
            "-crf", str(opts.vp9_crf), "-b:v", "0",
        ])
    if codec == "vp8":
        return CodecProfile(True, "mkv", "libvpx", [
            "-deadline", "good", "-cpu-used", str(opts.vp8_cpu_used),
            "-crf", str(opts.vp8_crf), "-b:v", "0",
        ])
    if codec == "mpeg2video":
        return CodecProfile(False, "mkv", "mpeg2video", ["-q:v", str(opts.mpeg2_q)])
    if codec == "mpeg4":
        return CodecProfile(False, "mkv", "mpeg4", ["-q:v", str(opts.mpeg4_q)])
    if codec == "prores":
        return CodecProfile(False, "mkv", "prores_ks", ["-profile:v", str(opts.prores_profile)])
    if codec == "mjpeg":
        return CodecProfile(False, "mkv", "mjpeg", ["-q:v", str(opts.mjpeg_q)])
    if codec == "dnxhd":
        return CodecProfile(False, "mkv", "dnxhd", [])
    if codec == "ffv1":
        return CodecProfile(False, "mkv", "ffv1", ["-level", "3"])
    if codec == "huffyuv":
        return CodecProfile(False, "mkv", "huffyuv", [])
    if codec == "theora":
        return CodecProfile(False, "mkv", "libtheora", ["-q:v", str(opts.theora_q)])
    die(f"Unsupported video codec for exact cutting: {codec}")
    raise AssertionError("unreachable")  # die() always raises; satisfies type checkers


def video_props_args(stream: dict) -> list[str]:
    args: list[str] = []
    pix_fmt = stream.get("pix_fmt")
    if pix_fmt and pix_fmt != "unknown":
        args += ["-pix_fmt", pix_fmt]
    for key, flag in (
        ("color_range", "-color_range"),
        ("color_space", "-colorspace"),
        ("color_transfer", "-color_trc"),
        ("color_primaries", "-color_primaries"),
    ):
        value = stream.get(key)
        if value and value != "unknown":
            args += [flag, value]
    return args


###############################################################################
# Context: everything derived from the input file once, up front


@dataclass
class Context:
    input: Path
    codec: str
    profile: CodecProfile
    smart_capable: bool
    video_props: list[str]
    src_duration: Decimal
    src_start_time: Decimal
    v_index: Optional[int]
    codec_tag: str
    time_base: str
    rotation: Decimal
    exact_audio_copy: bool = False


###############################################################################
# Safe splice-point detection


def first_packet_nal_types(ctx: Context, t: Decimal) -> list[int]:
    """NAL unit types seen in the first packet at/after time t, in order, by
    asking ffmpeg to trace headers on a single copied frame. A packet can
    carry several NALs (e.g. H.264 SPS + PPS + slice), so callers need every
    type in order, not just the first one."""
    seek = t + NUDGE
    cmd = [
        "ffmpeg", "-hide_banner", "-loglevel", "verbose",
        "-ss", fmt_time(seek),
        "-i", str(ctx.input),
        "-map", "0:V:0", "-frames:v", "1",
        "-c:v", "copy", "-bsf:v", "trace_headers",
        "-f", "null", "-",
    ]
    result = run_captured(cmd)
    types: list[int] = []
    seen_packet = False
    in_first_packet = False
    for line in (result.stderr or "").splitlines():
        if "Packet:" in line:
            if seen_packet:
                break
            seen_packet = True
            in_first_packet = True
            continue
        if in_first_packet and "nal_unit_type" in line:
            match = re.search(r"(-?\d+)\s*$", line.strip())
            if match:
                types.append(int(match.group(1)))
    return types


def is_safe_ra(ctx: Context, t: Decimal) -> bool:
    """A keyframe is only a safe splice point if its packet's first *slice*
    NAL (as opposed to a parameter-set NAL like SPS/PPS/VPS, which precedes
    it in the same packet) is an IDR (H.264) or IDR/BLA (HEVC; CRA is
    intentionally rejected - see module docstring)."""
    if ctx.codec in ("av1", "vp9", "vp8"):
        return True
    if ctx.codec == "h264":
        for n in first_packet_nal_types(ctx, t):
            if 1 <= n <= 5:
                return n == 5
        return False
    if ctx.codec == "hevc":
        for n in first_packet_nal_types(ctx, t):
            if 0 <= n <= 31:
                return n in (16, 17, 18, 19, 20)
        return False
    return False


def list_keyframes(ctx: Context, probe_from: Decimal, probe_to: Decimal) -> list[Decimal]:
    probe_from_abs = ctx.src_start_time + probe_from
    probe_to_abs = ctx.src_start_time + probe_to
    data = ffprobe_json(
        ctx.input,
        "-read_intervals", f"{fmt_time(probe_from_abs)}%{fmt_time(probe_to_abs)}",
        "-select_streams", "V:0",
        "-show_packets",
        "-show_entries", "packet=pts_time,flags",
    )
    seen: set[str] = set()
    keyframes: list[Decimal] = []
    for packet in data.get("packets") or []:
        pts_time = packet.get("pts_time")
        flags = packet.get("flags") or ""
        if not pts_time or pts_time == "N/A" or "K" not in flags:
            continue
        t = Decimal(pts_time) - ctx.src_start_time
        key = str(t)
        if key not in seen:
            seen.add(key)
            keyframes.append(t)
    return keyframes


def find_splice_points(
    ctx: Context, start_sec: Decimal, end_sec: Decimal, ra_scan_limit: int
) -> tuple[Optional[Decimal], Optional[Decimal]]:
    if not ctx.smart_capable:
        return None, None

    probe_from = max(start_sec - 5, Decimal(0))
    probe_to = min(end_sec + 5, ctx.src_duration)
    keyframes = list_keyframes(ctx, probe_from, probe_to)
    if not keyframes:
        return None, None

    k_start: Optional[Decimal] = None
    checked = 0
    for k in keyframes:
        if k < start_sec - K_SEARCH_EPSILON:
            continue
        if k > end_sec:
            break
        checked += 1
        if is_safe_ra(ctx, k):
            k_start = k
            break
        if checked >= ra_scan_limit:
            break

    k_end: Optional[Decimal] = None
    checked = 0
    for k in reversed(keyframes):
        if k > end_sec + K_SEARCH_EPSILON:
            continue
        if k < start_sec:
            break
        checked += 1
        if is_safe_ra(ctx, k):
            k_end = k
            break
        if checked >= ra_scan_limit:
            break

    return k_start, k_end


###############################################################################
# Frame-aligned cut boundaries
#
# A cut boundary that lands exactly on a frame's timestamp is fragile: ffprobe
# prints timestamps rounded to 6 decimals, so the same keyframe can compare as
# a hair before or after itself depending on how that particular value
# rounded, and ffmpeg's own -ss/-t comparisons have their own tolerances. The
# visible results were a frame duplicated or lost at a seam, and, when the
# window before the first keyframe held no whole frame, an empty segment that
# crashed the join. Every boundary is therefore expressed as the time midway
# between the last frame before it and the first frame at/after it, where no
# rounding can matter. A frame belongs to the cut when its timestamp is in
# [start, end), with EQ_EPSILON of slack so an exactly-typed frame time counts
# as that frame.


def frame_times(ctx: Context, lo: Decimal, hi: Decimal) -> list[Decimal]:
    """Presentation times (relative to the source start) of the primary video
    stream's frames around [lo, hi], ascending. Empty if ffprobe can't say."""
    probe_from = max(lo, Decimal(0))
    data = ffprobe_json(
        ctx.input,
        "-read_intervals", f"{fmt_time(ctx.src_start_time + probe_from)}%{fmt_time(ctx.src_start_time + hi)}",
        "-select_streams", "V:0",
        "-show_packets",
        "-show_entries", "packet=pts_time",
    )
    times: set[Decimal] = set()
    for packet in data.get("packets") or []:
        pts_time = packet.get("pts_time")
        if pts_time and pts_time != "N/A":
            times.add(Decimal(pts_time) - ctx.src_start_time)
    return sorted(times)


def frame_boundary(ctx: Context, t: Decimal) -> Decimal:
    """The time that separates the frames before `t` from the frames at/after
    it, midway between the two nearest ones. Falls back to `t` less the slack
    when the frame timestamps can't be read."""
    times = frame_times(ctx, t - 2, t + 2)
    before = [x for x in times if x < t - EQ_EPSILON]
    after = [x for x in times if x >= t - EQ_EPSILON]
    if before and after:
        return (before[-1] + after[0]) / 2
    if after:
        gap = after[1] - after[0] if len(after) > 1 else Decimal("0.04")
        return max(after[0] - gap / 2, Decimal(0))
    if before:
        gap = before[-1] - before[-2] if len(before) > 1 else Decimal("0.04")
        return before[-1] + gap / 2
    return max(t - EQ_EPSILON, Decimal(0))


###############################################################################
# Encoding / copying segments


def frames_in_window(ctx: Context, start: Decimal, end: Decimal) -> Optional[list[Decimal]]:
    """Timestamps of the frames in [start, end), with EQ_EPSILON of slack; None
    when the stream's frame timestamps can't be read at all (no way to tell an
    empty window from an unreadable one otherwise)."""
    times = frame_times(ctx, start - 2, end + 2)
    if not times:
        return None
    return [t for t in times if start - EQ_EPSILON <= t < end - EQ_EPSILON]


def encode_segment(ctx: Context, start: Decimal, end: Decimal, out: Path) -> None:
    """Re-encode the frames in [start, end). ffmpeg's own -ss/-t comparisons are
    unreliable at frame-sized windows (a window narrower than a frame can give an
    empty file, one ending on a frame can keep or drop it), so the segment is
    asked for by position -- -ss just before its first frame -- and an exact
    frame count instead. Unlike a seek midway between frames, a seek this close
    to the first frame leaves the output timestamps on the source's own grid.
    See "Frame-aligned cut boundaries"."""
    frames = frames_in_window(ctx, start, end)
    if frames:  # None (unreadable) or empty (callers skip empty windows) both take the fallback
        limit = ["-frames:v", str(len(frames))]
        seek = max(frames[0] - SEEK_LEAD, Decimal(0))
    else:  # frame timestamps unreadable: fall back to ffmpeg's own time limits
        limit = ["-t", fmt_time(end - start)]
        seek = start
    cmd = [
        "ffmpeg", "-hide_banner", "-loglevel", "error", "-stats", "-y",
        "-ss", fmt_time(seek),
        "-noautorotate",
        "-i", str(ctx.input),
        *limit,
        "-map", "0:V:0",
        "-an", "-sn", "-dn",
        "-c:v", ctx.profile.encoder,
        *ctx.profile.enc_args,
        *ctx.video_props,
        "-fps_mode", "passthrough",
        str(out),
    ]
    run_ffmpeg(cmd)


START_SYNC_CHOICES = ("frame", "audio", "off")


def resolve_start_sync(
    ctx: Context, mode: str, start_sec: Decimal, end_sec: Decimal
) -> tuple[Decimal, Decimal]:
    """Where the first video frame sits relative to the requested start. The video
    segment begins on its first whole frame, which is up to one frame after START;
    audio, subtitles and chapters are cut at exactly START. Returns
    (aux_start, video_offset): where the non-video streams are cut, and how far the
    video is delayed in the output, chosen by --start-sync:

      off    (0, ...) the video begins at zero and the rest at START, so the video
             runs early against the audio by the gap (what ffcut used to do);
      audio  the rest are cut at START and the video is delayed by the gap -- in sync,
             with a short empty lead-in on the video (an edit list in MP4);
      frame  the rest are cut at the first frame instead -- in sync, nothing empty,
             and the cut begins up to one frame after START.

    The gap is unknown (so no correction is possible) when the frame timestamps
    can't be read."""
    frames = None if mode == "off" else frames_in_window(ctx, start_sec, end_sec)
    if not frames:
        return start_sec, Decimal(0)
    gap = max(frames[0] - start_sec, Decimal(0))
    if mode == "audio":
        return start_sec, gap
    return start_sec + gap, Decimal(0)


def copy_middle(ctx: Context, start: Decimal, end: Decimal, out: Path) -> None:
    # A tiny nudge makes ffmpeg seek to the keyframe at/before "start".
    seek = start + NUDGE
    raw_from = fmt_time(ctx.src_start_time + start)
    # Packets are kept when their timestamp is in [start, end); the thresholds sit
    # midway between frames (not on `start`/`end`, which are frame timestamps whose
    # 6-decimal rounding could keep or drop the boundary frame by accident -- a
    # duplicate or missing frame at the seam). Timestamps are still shifted by the
    # real start so the segment begins at zero as before.
    drop_below = fmt_time(ctx.src_start_time + frame_boundary(ctx, start))
    drop_from = fmt_time(ctx.src_start_time + frame_boundary(ctx, end))

    bsf = f"noise=drop='lt(pts*tb,{drop_below})+gte(pts*tb,{drop_from})',setts=pts=PTS-{raw_from}/TB:dts=DTS-{raw_from}/TB"
    if ctx.codec == "h264":
        bsf += ",h264_mp4toannexb"
    elif ctx.codec == "hevc":
        bsf += ",hevc_mp4toannexb"

    cmd = [
        "ffmpeg", "-hide_banner", "-loglevel", "error", "-stats", "-y",
        "-copyts",
        "-ss", fmt_time(seek),
        "-i", str(ctx.input),
        "-map", "0:V:0", "-an", "-sn", "-dn",
        "-c:v", "copy",
        "-bsf:v", bsf,
        str(out),
    ]
    run_ffmpeg(cmd)


def smart_render(
    ctx: Context, start_sec: Decimal, end_sec: Decimal, k_start: Decimal, k_end: Decimal, tmpdir: Path
) -> Path:
    parts: list[Path] = []
    # How long each part plays in the source's own timeline (None = unknown). Written
    # into the concat list rather than left to the demuxer, which has to guess a part's
    # duration from its timestamps and guesses half a frame short for a one-frame part.
    durations: list[Optional[Decimal]] = []
    middle_start = k_start
    middle_end = k_end

    # The head is every frame in [start, k_start). When start falls within one frame
    # of k_start there is none: the cut simply begins on the keyframe.
    head_frames = None if flt_eq(start_sec, k_start) else frames_in_window(ctx, start_sec, k_start)
    if not flt_eq(start_sec, k_start) and head_frames != []:
        head = tmpdir / f"head.{ctx.profile.intermediate_ext}"
        encode_segment(ctx, start_sec, k_start, head)
        parts.append(head)
        durations.append(k_start - head_frames[0] if head_frames else None)

    if middle_end > middle_start:
        body = tmpdir / f"body.{ctx.profile.intermediate_ext}"
        copy_middle(ctx, middle_start, middle_end, body)
        parts.append(body)
        durations.append(middle_end - middle_start)

    if not flt_eq(end_sec, k_end):
        tail = tmpdir / f"tail.{ctx.profile.intermediate_ext}"
        encode_segment(ctx, k_end, end_sec, tail)
        parts.append(tail)
        durations.append(None)  # last part: nothing follows it

    hybrid = tmpdir / f"hybrid.{ctx.profile.intermediate_ext}"
    if len(parts) == 1:
        shutil.copy(parts[0], hybrid)
    else:
        lines = ["ffconcat version 1.0\n"]
        for part, duration in zip(parts, durations):
            lines.append(f"file '{part.name}'\n")
            if duration is not None:
                lines.append(f"duration {fmt_time(duration)}\n")
        concat_file = tmpdir / "parts.ffconcat"
        concat_file.write_text("".join(lines), encoding="utf-8")
        run_ffmpeg(
            [
                "ffmpeg", "-hide_banner", "-loglevel", "error", "-stats", "-y",
                "-f", "concat", "-safe", "0",
                "-i", concat_file.name,
                "-map", "0:v:0", "-c:v", "copy",
                hybrid.name,
            ],
            cwd=tmpdir,
        )
    return hybrid


def verify_decode(path: Path) -> bool:
    cmd = [
        "ffmpeg", "-hide_banner", "-loglevel", "error", "-xerror",
        "-i", str(path),
        "-map", "0:v:0", "-an", "-sn", "-dn",
        "-f", "null", "-",
    ]
    result = run_captured(cmd)
    return result.returncode == 0


