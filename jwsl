def cmd_setup(args, config):
    if args.non_interactive:
        setup_dependencies(config)
        return

    print("Let's get jwsl set up. Press Enter to accept the suggested answer shown in [brackets].\n")
    setup_dependencies(config)
    jwlangs = load_jwlangs()

    current = config.get("languages", DEFAULT_CONFIG["languages"])
    print(f"\nCurrent language list: {', '.join(lang_display(c, jwlangs) for c in current.split(','))}")
    ans = input(f"Which sign languages do you usually watch? Comma-separated codes (see https://www.jw.org/en/languages) [{current}]: ").strip()
    if ans:
        config["languages"] = ",".join(c.strip().upper() for c in ans.split(",") if c.strip())

    ans = input(f"\nHow much disk space can jwsl use to cache downloaded chapters, in GB? [{config.get('cache_max_gb', DEFAULT_CONFIG['cache_max_gb'])}]: ").strip()
    if ans:
        config["cache_max_gb"] = ans
        config["cache_policy"] = "lru"

    print("\n60fps playback options:")
    print("  rife         - fastest and best quality, but needs a one-time download (uses your graphics card)")
    print("  minterpolate - works right now with no extra download, but is slow (uses your processor)")
    print("  none         - skip 60fps conversion")
    ans = (input("Which one do you want? [rife]: ").strip().lower() or "rife")
    if ans not in ("rife", "minterpolate", "framerate", "none"):
