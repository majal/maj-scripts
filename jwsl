#!/usr/bin/env python3
"""
jwsl - JW Sign Language Video Tool
Downloads, syncs, extracts, overlays, and interpolates JW SL videos.
"""
import argparse
import json
import os
import platform
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.parse
import urllib.request
from pathlib import Path

# Paths
CONFIG_DIR = Path.home() / ".config" / "maj-scripts" / "jwsl"
CONFIG_FILE = CONFIG_DIR / "config.toml"
STATE_FILE = CONFIG_DIR / "state.json"
DEFAULT_CACHE_DIR = Path.home() / ".cache" / "jwsl"

# Default configs
DEFAULT_CONFIG = {
    "cache_dir": str(DEFAULT_CACHE_DIR),
    "cache_policy": "keep_all", # keep_all, delete_after_use
    "hardware_encoder": "cpu", # nvenc, videotoolbox, qsv, cpu
    "interpolation_engine": "none", # none, minterpolate, rife, framerate
    "default_target_lang": "FSL",
    "rife_binary_path": "",
    "font_path": "",
    "api_language": "E", # Language for book names (e.g., E for English)
}

# --- Config Management ---
def load_config():
    if not CONFIG_FILE.exists():
        return DEFAULT_CONFIG
    config = DEFAULT_CONFIG.copy()
    try:
        with open(CONFIG_FILE, "r") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or line.startswith("["):
                    continue
                if "=" in line:
                    k, v = line.split("=", 1)
                    k = k.strip()
                    v = v.strip().strip("'").strip('"')
                    config[k] = v
    except Exception as e:
        print(f"Warning: could not parse config: {e}")
    return config

def save_config(config):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    with open(CONFIG_FILE, "w") as f:
        for k, v in config.items():
            f.write(f'{k} = "{v}"\n')

def get_state():
    if not STATE_FILE.exists():
        return {}
    try:
        with open(STATE_FILE, "r") as f:
            return json.load(f)
    except:
        return {}

def save_state(state):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    with open(STATE_FILE, "w") as f:
        json.dump(state, f, indent=2)

# --- System Check & Setup ---
def command_exists(cmd):
    return shutil.which(cmd) is not None

def setup_dependencies():
    print("Setting up dependencies...")
    system = platform.system()
    if not command_exists("ffmpeg"):
        if system == "Darwin":
            print("Installing FFmpeg with freetype/fontconfig on macOS...")
            subprocess.run(["brew", "tap", "homebrew-ffmpeg/ffmpeg"], check=True)
            subprocess.run(["brew", "install", "homebrew-ffmpeg/ffmpeg/ffmpeg", "--with-freetype", "--with-fontconfig"], check=True)
        elif system == "Linux":
            print("Installing FFmpeg on Linux...")
            subprocess.run(["sudo", "apt", "update"], check=True)
            subprocess.run(["sudo", "apt", "install", "-y", "ffmpeg"], check=True)
        else:
            print("Please manually install FFmpeg on Windows (e.g., winget install ffmpeg).")
    else:
        print("FFmpeg is already installed.")

    print("\nTo set up RIFE (rife-ncnn-vulkan) for ultra-fast GPU interpolation:")
    print("Download the latest release from: https://github.com/nihui/rife-ncnn-vulkan/releases")
    print("Extract it and set the path in config using: jwsl config set rife_binary_path /path/to/rife-ncnn-vulkan")

# --- API & Network ---
def fetch_json(url):
    try:
        req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)'})
        with urllib.request.urlopen(req) as response:
            return json.loads(response.read().decode('utf-8'))
    except Exception as e:
        print(f"Error fetching {url}: {e}")
        return None

def get_pub_media_links(lang, booknum=None):
    url = f"https://b.jw-cdn.org/apis/pub-media/GETPUBMEDIALINKS?output=json&pub=nwt&fileformat=MP4%2CM4V&alllangs=0&langwritten={lang}&txtCMSLang={lang}"
    if booknum:
        url += f"&booknum={booknum}"
    return fetch_json(url)

def get_bible_metadata(lang_code):
    # Try fetching NWT study bible metadata to resolve book names/numbers
    url = f"https://www.jw.org/{lang_code.lower()}/library/bible/study-bible/books/json/"
    # For simplicity, fallback to English NWT
    if lang_code != "E":
        url = "https://www.jw.org/en/library/bible/study-bible/books/json/"
    return fetch_json(url)

def download_file(url, output_path):
    print(f"Downloading {url}...")
    try:
        urllib.request.urlretrieve(url, output_path)
        print("Download complete.")
        return True
    except Exception as e:
        print(f"Download failed: {e}")
        return False

# --- Video Processing ---
def run_ffmpeg(args):
    cmd = ["ffmpeg", "-hide_banner", "-loglevel", "warning", "-y"] + args
    print(f"Running: {' '.join(cmd)}")
    subprocess.run(cmd, check=True)

def interpolate_rife(input_video, output_video, config):
    rife_path = config.get("rife_binary_path")
    if not rife_path or not command_exists(rife_path):
        print("RIFE binary not found. Falling back to ffmpeg framerate filter.")
        run_ffmpeg(["-i", input_video, "-vf", "framerate=fps=60", output_video])
        return

    print("Interpolating using rife-ncnn-vulkan...")
    with tempfile.TemporaryDirectory() as temp_dir:
        temp_dir_path = Path(temp_dir)
        in_frames = temp_dir_path / "in"
        out_frames = temp_dir_path / "out"
        in_frames.mkdir()
        out_frames.mkdir()
        
        # 1. Extract frames
        run_ffmpeg(["-i", input_video, f"{in_frames}/%08d.png"])
        
        # 2. Run RIFE
        subprocess.run([rife_path, "-i", str(in_frames), "-o", str(out_frames)], check=True)
        
        # 3. Merge frames and audio
        audio_path = temp_dir_path / "audio.aac"
        subprocess.run(["ffmpeg", "-y", "-i", input_video, "-vn", "-c:a", "copy", str(audio_path)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        
        merge_cmd = ["-r", "60", "-i", f"{out_frames}/%08d.png"]
        if audio_path.exists() and audio_path.stat().st_size > 0:
            merge_cmd.extend(["-i", str(audio_path), "-c:a", "copy"])
        merge_cmd.extend(["-c:v", "libx264", "-crf", "20", "-preset", "fast", output_video])
        run_ffmpeg(merge_cmd)

def extract_verse(input_file, output_file, start_time, end_time, book_name, chapter, verse, config):
    engine = config.get("interpolation_engine", "none")
    hw = config.get("hardware_encoder", "cpu")
    
    # Base extraction with overlay
    font_arg = ""
    font_path = config.get("font_path")
    if font_path and os.path.exists(font_path):
        font_arg = f":fontfile='{font_path}'"
    
    drawtext = f"drawtext=text='{book_name} {chapter}\\:{verse}'{font_arg}:fontcolor=white:fontsize=34:x=93:y=54:alpha=0.66"
    
    # Encode options
    encode_opts = ["-c:a", "copy"]
    if hw == "nvenc":
        encode_opts.extend(["-c:v", "h264_nvenc"])
    elif hw == "videotoolbox":
        encode_opts.extend(["-c:v", "h264_videotoolbox"])
    else:
        encode_opts.extend(["-c:v", "libx264"])
        
    filter_chain = drawtext

    with tempfile.TemporaryDirectory() as tmp_dir:
        tmp_out = Path(tmp_dir) / "extracted.mp4"
        
        # Step 1: Extract and overlay text
        cmd = [
            "-ss", str(start_time),
            "-to", str(end_time),
            "-i", str(input_file),
            "-vf", filter_chain
        ] + encode_opts + [str(tmp_out)]
        run_ffmpeg(cmd)

        # Step 2: Interpolate (if requested)
        if engine == "rife":
            interpolate_rife(str(tmp_out), str(output_file), config)
        elif engine == "minterpolate":
            print("Interpolating using ffmpeg minterpolate...")
            minterp = "minterpolate=fps=60:mi_mode=mci:mc_mode=aobmc:me_mode=bidir:vsbmc=1"
            run_ffmpeg(["-i", str(tmp_out), "-vf", minterp] + encode_opts + [str(output_file)])
        elif engine == "framerate":
            print("Interpolating using ffmpeg framerate...")
            run_ffmpeg(["-i", str(tmp_out), "-vf", "framerate=fps=60"] + encode_opts + [str(output_file)])
        else:
            shutil.copy(tmp_out, output_file)

def parse_reference(ref_str):
    # E.g., "Rev 13:1, 2" or "Psalms 1:1, 2, 4-6"
    match = re.match(r"(.+?)\s+(\d+):(.+)", ref_str)
    if not match:
        return None, None, []
    book, chapter, verses_str = match.groups()
    
    # Parse verses
    verses = []
    for part in verses_str.replace(" ", "").split(","):
        if "-" in part:
            start, end = part.split("-")
            verses.extend(list(range(int(start), int(end)+1)))
        else:
            verses.append(int(part))
    return book.strip(), int(chapter), sorted(list(set(verses)))

def get_chapter_timestamps(input_file):
    # Use ffprobe to get chapter metadata
    cmd = ["ffprobe", "-hide_banner", "-loglevel", "quiet", "-show_chapters", "-print_format", "json", str(input_file)]
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, check=True)
        data = json.loads(result.stdout)
        chapters = {}
        for ch in data.get("chapters", []):
            title = ch.get("tags", {}).get("title", "")
            # Titles typically look like "1" or "13:1"
            parts = title.strip().split(":")
            verse_num = parts[-1] if parts else title.strip()
            try:
                verse = int(re.sub(r'[^0-9]', '', verse_num))
                chapters[verse] = {
                    "start": float(ch["start_time"]),
                    "end": float(ch["end_time"])
                }
            except:
                pass
        return chapters
    except Exception as e:
        print(f"Error reading chapters: {e}")
        return {}

# --- Commands ---
def cmd_setup(args, config):
    setup_dependencies()

def cmd_config(args, config):
    if args.key and args.value:
        config[args.key] = args.value
        save_config(config)
        print(f"Set {args.key} = {args.value}")
    elif args.key:
        print(f"{args.key} = {config.get(args.key)}")
    else:
        for k, v in config.items():
            print(f"{k} = {v}")

def cmd_sync(args, config):
    lang = args.lang.upper()
    print(f"Syncing metadata for {lang}...")
    data = get_pub_media_links(lang)
    if not data:
        return
        
    state = get_state()
    if lang not in state:
        state[lang] = {}
        
    # Analyze files
    mp4s = data.get("files", {}).get(lang, {}).get("MP4", [])
    count = 0
    for file in mp4s:
        if file.get("label") == "720p":
            url = file["file"]["url"]
            checksum = file["file"]["checksum"]
            booknum = file.get("booknum")
            track = file.get("track")
            key = f"{booknum}_{track}"
            
            if state[lang].get(key, {}).get("checksum") != checksum:
                state[lang][key] = {"url": url, "checksum": checksum, "downloaded": False}
                count += 1
                
    save_state(state)
    print(f"Found {count} new/updated files for {lang}.")

def resolve_book_number(book_name, lang="E"):
    metadata = get_bible_metadata(lang)
    if not metadata:
        return None
    for b_id, b_data in metadata.get("editionData", {}).get("books", {}).items():
        if book_name.lower() in b_data.get("standardSingularBookName", "").lower():
            return int(b_id)
        if book_name.lower() in b_data.get("officialAbbreviation", "").lower():
            return int(b_id)
    return None

def cmd_extract(args, config):
    lang = args.lang.upper()
    ref = args.reference
    
    book_name, chapter, verses = parse_reference(ref)
    if not book_name:
        print(f"Could not parse reference: {ref}. Use format 'Book Chapter:Verse(s)' (e.g., 'Rev 13:1, 2')")
        return
        
    print(f"Extracting {book_name} {chapter}:{verses} in {lang}...")
    
    # 1. Resolve book number
    book_num = resolve_book_number(book_name, config.get("api_language", "E"))
    if not book_num:
        # Fallback dictionary for common English names
        common = {"gen":1, "ex":2, "ps":19, "psalms":19, "prov":20, "matt":40, "rev":66, "revelation":66}
        for k,v in common.items():
            if k in book_name.lower():
                book_num = v
                break
                
    if not book_num:
        print(f"Could not resolve book number for {book_name}. Please use full English names for now.")
        return
        
    # 2. Get URL
    data = get_pub_media_links(lang, book_num)
    if not data:
        return
    
    url = None
    mp4s = data.get("files", {}).get(lang, {}).get("MP4", [])
    for file in mp4s:
        if file.get("label") == "720p" and file.get("track") == chapter:
            url = file["file"]["url"]
            break
            
    if not url:
        print(f"Could not find 720p video for book {book_num} chapter {chapter} in {lang}.")
        return
        
    # 3. Check Cache
    cache_dir = Path(config["cache_dir"]) / lang
    cache_dir.mkdir(parents=True, exist_ok=True)
    
    filename = url.split("/")[-1]
    local_path = cache_dir / filename
    
    if not local_path.exists():
        if not download_file(url, local_path):
            return
    else:
        print("Using cached video file.")
        
    # 4. Extract verses
    chapters_meta = get_chapter_timestamps(local_path)
    if not chapters_meta:
        print("Failed to read chapter metadata from the video.")
        return
        
    # Find start and end times for requested verses
    valid_verses = [v for v in verses if v in chapters_meta]
    if not valid_verses:
        print(f"Verses {verses} not found in video metadata.")
        return
        
    start_time = chapters_meta[valid_verses[0]]["start"]
    end_time = chapters_meta[valid_verses[-1]]["end"]
    
    out_filename = f"{book_name.replace(' ','_')}_{chapter}_{'_'.join(map(str, valid_verses))}_{lang}.mp4"
    
    # Extract & Interpolate
    extract_verse(
        local_path, out_filename, 
        start_time, end_time, 
        book_name, chapter, 
        f"{valid_verses[0]}" if len(valid_verses)==1 else f"{valid_verses[0]}-{valid_verses[-1]}", 
        config
    )
    
    print(f"Successfully created: {out_filename}")
    
    # Cleanup based on policy
    if config.get("cache_policy") == "delete_after_use":
        os.remove(local_path)
        print("Cleaned up cached video file.")

def cmd_cache(args, config):
    if args.action == "clean":
        cache_dir = Path(config["cache_dir"])
        if cache_dir.exists():
            shutil.rmtree(cache_dir)
            print("Cache cleared.")
        else:
            print("Cache is already empty.")

# --- Main ---
def main():
    parser = argparse.ArgumentParser(description="jwsl - JW Sign Language Video Tool")
    subparsers = parser.add_subparsers(dest="command")

    # setup
    subparsers.add_parser("setup", help="Install dependencies (ffmpeg, etc)")
    
    # config
    p_config = subparsers.add_parser("config", help="Manage configuration")
    p_config.add_argument("action", choices=["set", "get", "list"], nargs="?", default="list")
    p_config.add_argument("key", nargs="?")
    p_config.add_argument("value", nargs="?")
    
    # sync
    p_sync = subparsers.add_parser("sync", help="Bulk sync metadata and track updates")
    p_sync.add_argument("lang", help="Sign language code (e.g., FSL)")
    
    # extract
    p_extract = subparsers.add_parser("extract", help="Extract and overlay verses from a chapter")
    p_extract.add_argument("lang", help="Sign language code (e.g., FSL)")
    p_extract.add_argument("reference", help="Bible reference (e.g., 'Rev 13:1, 2')")
    p_extract.add_argument("--interpolate", action="store_true", help="Force interpolation on output")
    
    # cache
    p_cache = subparsers.add_parser("cache", help="Manage cache")
    p_cache.add_argument("action", choices=["clean"])
    
    args = parser.parse_args()
    config = load_config()
    
    if args.command == "setup":
        cmd_setup(args, config)
    elif args.command == "config":
        if args.action == "set" and args.key and args.value:
            cmd_config(args, config)
        elif args.action == "list":
            cmd_config(argparse.Namespace(key=None, value=None), config)
        else:
            print("Usage: jwsl config set <key> <value>")
    elif args.command == "sync":
        cmd_sync(args, config)
    elif args.command == "extract":
        if args.interpolate:
            # temporary override
            if config.get("interpolation_engine") == "none":
                config["interpolation_engine"] = "minterpolate" # fallback
        cmd_extract(args, config)
    elif args.command == "cache":
        cmd_cache(args, config)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
