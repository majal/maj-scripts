    if ans == "rife" and not (config.get("rife_binary_path") and command_exists(config["rife_binary_path"])):
        print(f"\nrife isn't installed yet. Download {rife_release_hint()}")
        print("from https://github.com/nihui/rife-ncnn-vulkan/releases, unzip it, then run:")
        print("  jwsl config set rife_binary_path /path/to/rife-ncnn-vulkan")
        print("(Until then, jwsl will automatically fall back to the framerate filter.)")

    hw = detect_hardware_encoder()
    print(f"\nDetected hardware video encoder for this machine: {hw}")
    config["hardware_encoder"] = hw

    ans = input("\nAdd jwsl to your PATH so you can type 'jwsl' from any folder on this machine? [Y/n]: ").strip().lower()
    if ans in ("", "y", "yes"):
