# Paths
CONFIG_DIR = Path.home() / ".config" / "maj-scripts" / "jwsl"
CONFIG_FILE = CONFIG_DIR / "config.toml"
STATE_FILE = CONFIG_DIR / "state.json"
INDEX_DIR = CONFIG_DIR / "index"  # one JSON file per synced language, kept out of state.json
DEFAULT_CACHE_DIR = Path.home() / ".cache" / "jwsl"
JWLANGS_FILE = Path(__file__).resolve().parent / "jwlangs.json"

MAX_ATTEMPTS = 3
RETRY_BACKOFF = 2

# Homebrew's plain 'ffmpeg' formula ships without freetype/fontconfig, so it
# can't draw text overlays. A full build is usually installed keg-only under
# a '-full' suffix so it can coexist with the plain formula; these are the
# places to look for it before falling back to plain ffmpeg.
FFMPEG_FULL_KEG_PATHS = [
    "/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg-full",
    "/usr/local/opt/ffmpeg-full/bin/ffmpeg-full",
]
FFPROBE_FULL_KEG_PATHS = [
    "/opt/homebrew/opt/ffmpeg-full/bin/ffprobe-full",
    "/usr/local/opt/ffmpeg-full/bin/ffprobe-full",
]

# Resolved once at startup by main() -> resolve_ffmpeg_binary/resolve_ffprobe_binary.
FFMPEG_BIN = "ffmpeg"
FFPROBE_BIN = "ffprobe"

# Default configs
DEFAULT_CONFIG = {
    "cache_dir": str(DEFAULT_CACHE_DIR),
    "cache_policy": "lru",  # keep_all, lru, delete_after_use
    "cache_max_gb": "5",
    "extract_mode": "onthefly",  # onthefly (stream, no disk use), cache (download chapter, reuse for later verses)
    "hardware_encoder": "cpu",  # nvenc, videotoolbox, qsv, cpu
