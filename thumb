#!/usr/bin/env python3
"""thumb: thumbnail generator for images and videos (whole folders or single files).

Features
--------
- Preserves aspect ratio; neither dimension exceeds --size.
- Folders: default output directory is ./thumbnails inside the folder.
- Single files: the thumbnail is written next to the source by default.
- Defaults can be set in ~/.config/maj-scripts/thumb/config.toml.
- Default output format is JPEG for broad compatibility.
- Images are auto-oriented from EXIF metadata.
- Videos prefer embedded artwork by default.
- Otherwise, samples nearly the whole timeline and lets FFmpeg choose a
  representative frame, then compares it with fallback timestamps to avoid
  black/blank selections.
- Folder scans cover images only unless --videos is given; hidden files are skipped. Optional recursive scan, include/exclude globs, mtime-only rebuilds,
  parallel jobs (auto by default), artwork-only mode, custom suffixes, and dry-run.
- Uses only Python's standard library plus ffmpeg/ffprobe/ImageMagick.
"""

from __future__ import annotations

import argparse
import concurrent.futures
import fnmatch
import json
import math
import os
import shutil
import signal
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path
from typing import Iterable, Optional

IMAGE_EXTS = {
    ".jpg", ".jpeg", ".png", ".webp", ".avif", ".heic", ".heif",
    ".tif", ".tiff", ".bmp", ".gif", ".jxl",
}
VIDEO_EXTS = {
    ".mp4", ".m4v", ".mov", ".mkv", ".webm", ".avi", ".mpg", ".mpeg",
    ".mts", ".m2ts", ".ts", ".3gp", ".wmv", ".flv", ".ogv",
}
SUPPORTED_OUTPUTS = ("jpg", "jpeg", "png", "webp", "avif")
PART_MARK = ".thumb-part"
CONFIG_PATH = Path.home() / ".config" / "maj-scripts" / "thumb" / "config.toml"
# config key -> expected type; keys match the long option names (dashes -> underscores)
CONFIG_KEYS: dict[str, type] = {
    "output": str,
    "file_output": str,
    "size": int,
    "quality": int,
    "format": str,
    "suffix": str,
    "samples": int,
    "jobs": int,
    "recursive": bool,
    "quiet": bool,
    "mtime_only": bool,
    "no_artwork": bool,
    "videos": bool,
    "video_at": str,
    "hidden": bool,
    "stale_check": bool,
}


@dataclass
class Result:
    status: str
    src: Path
    dst: Optional[Path] = None
    reason: str = ""


class SkipMedia(Exception):
    pass


def eprint(*args: object) -> None:
    print(*args, file=sys.stderr)


def run(cmd: list[str], *, capture: bool = False) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        cmd,
        check=True,
        text=True,
        stdout=subprocess.PIPE if capture else subprocess.DEVNULL,
        stderr=subprocess.PIPE,
    )


def describe_error(exc: BaseException) -> str:
    """Short, human-readable reason for a failed external command."""
    if isinstance(exc, subprocess.CalledProcessError):
        detail = (exc.stderr or "").strip().splitlines()
        tool = Path(str(exc.cmd[0])).name if exc.cmd else "command"
        return f"{tool} failed: {detail[-1]}" if detail else f"{tool} failed (exit {exc.returncode})"
    return str(exc)


def require_tools() -> None:
    missing = [x for x in ("ffmpeg", "ffprobe", "magick") if shutil.which(x) is None]
    if missing:
        raise SystemExit(
            "Missing required command(s): "
            + ", ".join(missing)
            + "\nOn macOS: brew install ffmpeg imagemagick"
        )


def probe_video(path: Path) -> tuple[Optional[float], Optional[int]]:
    """Return (duration_seconds, attached_picture_stream_index)."""
    cp = run(
        [
            "ffprobe", "-v", "error",
            "-show_streams", "-show_format",
            "-of", "json",
            str(path),
        ],
        capture=True,
    )
    data = json.loads(cp.stdout)

    duration: Optional[float] = None
    raw_duration = data.get("format", {}).get("duration")
    try:
        if raw_duration is not None:
            d = float(raw_duration)
            if math.isfinite(d) and d > 0:
                duration = d
    except (TypeError, ValueError):
        pass

    attached: Optional[int] = None
    for stream in data.get("streams", []):
        if stream.get("codec_type") != "video":
            continue
        if stream.get("disposition", {}).get("attached_pic") == 1:
            try:
                attached = int(stream["index"])
                break
            except (KeyError, TypeError, ValueError):
                pass

    return duration, attached


def fingerprint(size: int, quality: int, outfmt: str, video_at: str, is_video: bool) -> str:
    """Settings that shape a thumbnail, stored in jpg/png metadata to spot stale ones."""
    parts = [f"size={size}"]
    if outfmt != "png":
        parts.append(f"quality={quality}")
    if is_video and video_at != "auto":
        parts.append(f"at={video_at}")
    return "thumb:1 " + " ".join(parts)


def read_thumb_info(path: Path) -> Optional[tuple[int, str]]:
    """Return (longest side, embedded fingerprint or '') for an existing thumbnail."""
    try:
        cp = run(["magick", "identify", "-format", "%w %h|%c", f"{path}[0]"], capture=True)
        dims, _, comment = cp.stdout.partition("|")
        w, h = (int(x) for x in dims.split())
        return max(w, h), comment.strip()
    except (subprocess.CalledProcessError, ValueError):
        return None


def source_longest_side(path: Path) -> Optional[int]:
    try:
        cp = run(["magick", "identify", "-format", "%w %h", f"{path}[0]"], capture=True)
        w, h = (int(x) for x in cp.stdout.split())
        return max(w, h)
    except (subprocess.CalledProcessError, ValueError):
        return None


def is_stale(src: Path, dst: Path, size: int, fp: str, is_video: bool) -> bool:
    """True when an existing thumbnail was made with different size/quality settings.

    Best effort: jpg/png carry an exact fingerprint; other formats are compared by
    dimensions only. Anything unreadable counts as not stale (never churn quietly).
    """
    info = read_thumb_info(dst)
    if info is None:
        return False
    longest, comment = info
    if longest > size:
        return True
    if comment.startswith("thumb:") and comment != fp:
        return True
    if not is_video and longest < size:
        src_longest = source_longest_side(src)
        if src_longest is not None and src_longest > longest + 1:
            return True
    return False


def magick_thumb(
    src: Path, dst: Path, size: int, quality: int, outfmt: str, fp: str = "",
) -> None:
    dst.parent.mkdir(parents=True, exist_ok=True)
    source = f"{src}[0]"

    cmd = [
        "magick", source,
        "-auto-orient",
        "-thumbnail", f"{size}x{size}>",
        "-strip",
    ]
    if fp and outfmt in {"jpg", "jpeg", "png"}:
        if outfmt == "png":
            cmd += ["-define", "png:include-chunk=tEXt"]
        cmd += ["-set", "comment", fp]

    if outfmt in {"jpg", "jpeg"}:
        cmd += [
            "-background", "white",
            "-alpha", "remove",
            "-alpha", "off",
            "-interlace", "Plane",
            "-quality", str(quality),
        ]
    elif outfmt in {"webp", "avif"}:
        cmd += ["-quality", str(quality)]
    elif outfmt == "png":
        cmd += ["-define", "png:compression-level=9"]

    cmd.append(str(dst))
    run(cmd)


def extract_attached_art(video: Path, stream_index: int, dst: Path) -> None:
    run(
        [
            "ffmpeg", "-hide_banner", "-loglevel", "error",
            "-nostdin", "-y",
            "-i", str(video),
            "-map", f"0:{stream_index}",
            "-frames:v", "1",
            str(dst),
        ]
    )


def resolve_video_at(video_at: str, duration: Optional[float]) -> Optional[float]:
    """Seconds for a fixed --video-at value ('25%' or '12.5'); None for 'auto'."""
    if video_at == "auto":
        return None
    if video_at.endswith("%"):
        pct = float(video_at[:-1]) / 100.0
        return duration * pct if duration else 10.0
    seconds = float(video_at)
    if duration:
        seconds = min(seconds, max(0.0, duration - 0.1))
    return seconds


def extract_frame(video: Path, timestamp: float, dst: Path) -> None:
    run(
        [
            "ffmpeg", "-hide_banner", "-loglevel", "error",
            "-nostdin", "-y",
            "-ss", f"{max(0.0, timestamp):.3f}",
            "-i", str(video),
            "-frames:v", "1",
            str(dst),
        ]
    )


def extract_representative(video: Path, duration: float, dst: Path, samples: int) -> None:
    """Sample nearly the whole video and let FFmpeg choose a representative frame."""
    if duration <= 1.0:
        extract_frame(video, duration * 0.5, dst)
        return

    start = min(duration * 0.05, 30.0)
    end_margin = min(duration * 0.05, 30.0)
    end = max(start + 0.1, duration - end_margin)
    span = max(0.1, end - start)

    n = max(12, min(samples, int(max(12.0, span * 2.0))))
    fps = n / span
    vf = (
        f"trim=start={start:.6f}:end={end:.6f},"
        "setpts=PTS-STARTPTS,"
        f"fps={fps:.8f},"
        f"thumbnail={n}"
    )

    run(
        [
            "ffmpeg", "-hide_banner", "-loglevel", "error",
            "-nostdin", "-y",
            "-i", str(video),
            "-vf", vf,
            "-frames:v", "1",
            str(dst),
        ]
    )


def image_score(path: Path) -> float:
    """Prefer non-blank frames with visual detail and sane brightness."""
    cp = run(
        [
            "magick", str(path),
            "-auto-orient",
            "-resize", "64x64!",
            "-colorspace", "Gray",
            "-format", "%[fx:mean] %[fx:standard_deviation] %[entropy]",
            "info:",
        ],
        capture=True,
    )
    parts = cp.stdout.strip().split()
    if len(parts) != 3:
        return -1e9

    try:
        mean, stdev, entropy = map(float, parts)
    except ValueError:
        return -1e9

    score = entropy * 2.0 + stdev * 0.8
    if mean < 0.06:
        score -= (0.06 - mean) * 20.0 + 2.0
    elif mean < 0.14:
        score -= (0.14 - mean) * 4.0
    if mean > 0.96:
        score -= (mean - 0.96) * 20.0 + 2.0
    elif mean > 0.90:
        score -= (mean - 0.90) * 4.0
    return score


def choose_video_frame(video: Path, duration: float, workdir: Path, samples: int) -> Path:
    candidates: list[tuple[Path, float]] = []

    representative = workdir / "representative.jpg"
    try:
        extract_representative(video, duration, representative, samples)
        candidates.append((representative, image_score(representative) + 0.30))
    except subprocess.CalledProcessError:
        pass

    for i, frac in enumerate((0.18, 0.32, 0.50, 0.68, 0.82), start=1):
        candidate = workdir / f"fallback-{i}.jpg"
        try:
            extract_frame(video, duration * frac, candidate)
            bias = 0.05 if frac == 0.50 else 0.0
            candidates.append((candidate, image_score(candidate) + bias))
        except subprocess.CalledProcessError:
            pass

    if not candidates:
        raise RuntimeError("FFmpeg could not extract any usable video frame")

    return max(candidates, key=lambda item: item[1])[0]


def video_thumb(
    src: Path,
    dst: Path,
    size: int,
    quality: int,
    samples: int,
    prefer_artwork: bool,
    artwork_only: bool,
    outfmt: str,
    video_at: str = "auto",
    fp: str = "",
) -> None:
    duration, attached = probe_video(src)

    if artwork_only and attached is None:
        raise SkipMedia("video has no embedded artwork")

    with tempfile.TemporaryDirectory(prefix="thumb-") as td:
        workdir = Path(td)

        if (prefer_artwork or artwork_only) and attached is not None:
            artwork = workdir / "artwork.png"
            try:
                extract_attached_art(src, attached, artwork)
                magick_thumb(artwork, dst, size, quality, outfmt, fp)
                return
            except subprocess.CalledProcessError:
                if artwork_only:
                    raise RuntimeError("embedded artwork exists but could not be extracted")

        if artwork_only:
            raise SkipMedia("video has no usable embedded artwork")

        fixed = resolve_video_at(video_at, duration)
        if fixed is not None:
            frame = workdir / "frame.jpg"
            extract_frame(src, fixed, frame)
        elif duration is None:
            frame = workdir / "frame.jpg"
            extract_frame(src, 10.0, frame)
        else:
            frame = choose_video_frame(src, duration, workdir, samples)

        magick_thumb(frame, dst, size, quality, outfmt, fp)


def pattern_matches(path: Path, root: Path, patterns: list[str]) -> bool:
    if not patterns:
        return False
    rel = path.relative_to(root).as_posix().lower()
    name = path.name.lower()
    return any(
        fnmatch.fnmatchcase(rel, pat.lower()) or fnmatch.fnmatchcase(name, pat.lower())
        for pat in patterns
    )


def iter_media(
    root: Path,
    recursive: bool,
    outdir: Path,
    includes: list[str],
    excludes: list[str],
    videos: bool = True,
    hidden: bool = False,
) -> Iterable[Path]:
    """Yield supported media under root in a stable, sorted order.

    Hidden files/directories (including macOS ``._*`` files) are skipped unless
    ``hidden`` is set; the output directory is never descended into.
    """
    out_resolved = outdir.resolve()

    for dirpath, dirnames, filenames in os.walk(root):
        here = Path(dirpath)
        dirnames[:] = sorted(
            d for d in dirnames
            if recursive
            and (hidden or not d.startswith("."))
            and (here / d).resolve() != out_resolved
        )

        for name in sorted(filenames):
            if name.startswith(".") and (not hidden or PART_MARK in name):
                continue  # hidden, or a leftover temp file from an interrupted run

            path = here / name
            ext = path.suffix.lower()
            if ext not in IMAGE_EXTS and not (videos and ext in VIDEO_EXTS):
                continue
            if not path.is_file():
                continue

            if includes and not pattern_matches(path, root, includes):
                continue
            if excludes and pattern_matches(path, root, excludes):
                continue

            yield path


def output_for(
    src: Path,
    root: Path,
    outdir: Path,
    recursive: bool,
    outfmt: str,
    suffix: str,
) -> Path:
    ext = ".jpg" if outfmt == "jpeg" else f".{outfmt}"
    name = f"{src.name}{suffix}{ext}"
    if recursive:
        rel_parent = src.parent.relative_to(root)
        return outdir / rel_parent / name
    return outdir / name


def should_process(src: Path, dst: Path, *, force: bool, mtime_only: bool) -> tuple[bool, str]:
    if force:
        return True, ""
    if not dst.exists():
        return True, ""
    if mtime_only:
        try:
            if src.stat().st_mtime > dst.stat().st_mtime:
                return True, ""
            return False, "thumbnail is newer than source"
        except OSError:
            return True, ""
    return False, "thumbnail already exists"


def load_config(path: Path) -> dict[str, object]:
    """Read optional TOML defaults; a missing file is fine, a bad one is a clear error."""
    if not path.is_file():
        return {}
    try:
        import tomllib
    except ImportError:
        raise SystemExit(f"{path}: config files need Python 3.11+ (tomllib); remove it or upgrade Python")
    try:
        data = tomllib.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        raise SystemExit(f"{path}: cannot read config: {exc}")
    out: dict[str, object] = {}
    for raw_key, value in data.items():
        key = raw_key.replace("-", "_")
        expected = CONFIG_KEYS.get(key)
        if expected is None:
            raise SystemExit(f"{path}: unknown setting '{raw_key}' (allowed: {', '.join(sorted(CONFIG_KEYS))})")
        if not isinstance(value, expected) or (expected is int and isinstance(value, bool)):
            raise SystemExit(f"{path}: '{raw_key}' must be {expected.__name__}")
        out[key] = value
    return out


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="thumb",
        description=(
            "Create aspect-ratio-preserving thumbnails for images (and, with --videos\n"
            "or when named directly, videos). Videos prefer embedded artwork;\n"
            "otherwise FFmpeg chooses a representative frame from across the timeline."
        ),
        epilog=(
            "Examples:\n"
            "  thumb\n"
            "  thumb photo.jpg clip.mp4          (thumbnails land next to each file)\n"
            "  thumb -o ~/thumbs photo.jpg\n"
            "  thumb ~/Pictures\n"
            "  thumb -r ~/Media\n"
            "  thumb -r --videos ~/Media          (include videos in folder scans)\n"
            "  thumb -r --include '*.jpg' --include '*.png' ~/Media\n"
            "  thumb -r --exclude 'cache/*' --exclude '*-preview.*' ~/Media\n"
            "  thumb --mtime-only ~/Pictures\n"
            "  thumb -j 4 -r ~/Media\n"
            "  thumb --artwork-only ~/Videos\n"
            "  thumb --no-artwork ~/Videos\n"
            "  thumb --suffix=-thumb ~/Pictures\n"
            "  thumb --format webp --quality 80 .\n"
            "  thumb --dry-run -r .\n"
            "\n"
            "Naming:\n"
            "  By default the original extension is retained in the basename to\n"
            "  avoid collisions. Example: photo.png -> photo.png.jpg.\n"
            "  --suffix=-thumb gives photo.png-thumb.jpg.\n"
            "\n"
            "Defaults:\n"
            "  input           : . (files and/or directories)\n"
            "  folder scans    : images only (add --videos for videos)\n"
            "  output (folders): ./thumbnails inside each folder\n"
            "  output (files)  : the file's own folder (--file-output)\n"
            "  config file     : ~/.config/maj-scripts/thumb/config.toml (CLI flags win)\n"
            "  maximum size    : 256 px\n"
            "  output format   : jpg\n"
            "  quality         : 85\n"
            "  jobs            : auto (one per CPU, max 8)\n"
            "\n"
            "Requirements:\n"
            "  ffmpeg, ffprobe, ImageMagick ('magick')\n"
            "  macOS: brew install ffmpeg imagemagick"
        ),
        formatter_class=argparse.RawTextHelpFormatter,
    )

    parser.add_argument(
        "paths",
        nargs="*",
        default=["."],
        metavar="PATH",
        help="files and/or directories to process (default: .)",
    )
    parser.add_argument(
        "-o", "--output",
        default=None,
        metavar="DIR",
        help=(
            "output directory for both folders and files; relative paths are created "
            "inside each scanned folder, or beside each single file "
            "(default: thumbnails for folders, --file-output for files)"
        ),
    )
    parser.add_argument(
        "--file-output",
        default=".",
        metavar="DIR",
        help=(
            "output directory for individually named files; relative to the file's "
            "folder (default: . = next to the source)"
        ),
    )
    parser.add_argument(
        "-s", "--size",
        type=int,
        default=256,
        metavar="PX",
        help="maximum width or height in pixels (default: 256)",
    )
    parser.add_argument(
        "-q", "--quality",
        type=int,
        default=85,
        metavar="N",
        help="quality for jpg/webp/avif, 1-100 (default: 85)",
    )
    parser.add_argument(
        "--format",
        choices=SUPPORTED_OUTPUTS,
        default="jpg",
        help="thumbnail output format (default: jpg)",
    )
    parser.add_argument(
        "--suffix",
        default="",
        metavar="TEXT",
        help=(
            "text appended after the source filename and before the output extension "
            "(default: none)"
        ),
    )
    parser.add_argument(
        "--videos",
        action="store_true",
        help=(
            "also thumbnail videos when scanning folders (default: images only, since "
            "automatic video frame choice is best-effort). Videos named directly as "
            "files are always processed; --artwork-only implies --videos"
        ),
    )
    parser.add_argument(
        "--video-at",
        default="auto",
        metavar="POS",
        help=(
            "pick video frames at a fixed position instead of automatically: a "
            "percentage ('25%%') or seconds ('12.5'). Embedded artwork still wins "
            "unless --no-artwork (default: auto)"
        ),
    )
    parser.add_argument(
        "--hidden",
        action="store_true",
        help="include hidden files and folders (dot-files, macOS ._* files) in scans",
    )
    parser.add_argument(
        "--stale-check",
        action=argparse.BooleanOptionalAction,
        default=True,
        help=(
            "rebuild existing thumbnails that were made with a different --size or "
            "--quality (best effort; default: on, use --no-stale-check to leave "
            "existing thumbnails alone)"
        ),
    )
    parser.add_argument(
        "--samples",
        type=int,
        default=120,
        metavar="N",
        help=(
            "maximum whole-video samples considered by FFmpeg's representative-frame "
            "selector (default: 120; minimum: 12)"
        ),
    )
    parser.add_argument(
        "-r", "--recursive",
        action="store_true",
        help="scan subdirectories of folder arguments and mirror their layout under the output directory",
    )
    parser.add_argument(
        "--include",
        action="append",
        default=[],
        metavar="GLOB",
        help=(
            "when scanning folders, process only paths matching this glob; may be repeated. "
            "Matches basename or path relative to the folder; ignored for files named directly"
        ),
    )
    parser.add_argument(
        "--exclude",
        action="append",
        default=[],
        metavar="GLOB",
        help=(
            "skip paths matching this glob; may be repeated. "
            "Exclusions override inclusions"
        ),
    )

    rebuild = parser.add_mutually_exclusive_group()
    rebuild.add_argument(
        "-f", "--force",
        action="store_true",
        help="recreate thumbnails even when output files already exist",
    )
    rebuild.add_argument(
        "--mtime-only",
        action="store_true",
        help=(
            "create missing thumbnails and rebuild existing ones only when the "
            "source file is newer"
        ),
    )

    artwork = parser.add_mutually_exclusive_group()
    artwork.add_argument(
        "--no-artwork",
        action="store_true",
        help="ignore embedded video artwork and always choose a frame from the video",
    )
    artwork.add_argument(
        "--artwork-only",
        action="store_true",
        help=(
            "for videos, create thumbnails only from embedded artwork; "
            "videos without artwork are skipped"
        ),
    )

    parser.add_argument(
        "-j", "--jobs",
        type=int,
        default=0,
        metavar="N",
        help=(
            "number of files to process in parallel; 0 = auto, one per CPU up to 8 "
            "(default: 0)"
        ),
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="show what would be created or skipped without writing files",
    )
    parser.add_argument(
        "--quiet",
        action="store_true",
        help="suppress per-file OK/SKIP lines; failures and final summary remain",
    )

    return parser


def process_one(
    src: Path,
    dst: Path,
    *,
    outfmt: str,
    size: int,
    quality: int,
    samples: int,
    prefer_artwork: bool,
    artwork_only: bool,
    force: bool,
    mtime_only: bool,
    dry_run: bool,
    video_at: str = "auto",
    stale_check: bool = False,
) -> Result:
    if src.suffix.lower() not in IMAGE_EXTS and src.suffix.lower() not in VIDEO_EXTS:
        return Result("skip", src, dst, "unsupported file type")

    is_video = src.suffix.lower() in VIDEO_EXTS
    fp = fingerprint(size, quality, outfmt, video_at, is_video)
    do_it, reason = should_process(src, dst, force=force, mtime_only=mtime_only)

    if not do_it and stale_check and is_stale(src, dst, size, fp, is_video):
        do_it, reason = True, "settings changed"

    if not do_it:
        return Result("skip", src, dst, reason)

    if dry_run:
        return Result("dry", src, dst, reason or "would create")

    # Write to a temp name, then rename, so an interrupted run never leaves a
    # half-written file that later looks like a finished thumbnail.
    tmp = dst.with_name(f".{dst.name}{PART_MARK}{dst.suffix}")
    try:
        if src.suffix.lower() in IMAGE_EXTS:
            magick_thumb(src, tmp, size, quality, outfmt, fp)
        else:
            video_thumb(
                src,
                tmp,
                size,
                quality,
                samples,
                prefer_artwork=prefer_artwork,
                artwork_only=artwork_only,
                outfmt=outfmt,
                video_at=video_at,
                fp=fp,
            )
        os.replace(tmp, dst)
        return Result("ok", src, dst, reason)
    except SkipMedia as exc:
        tmp.unlink(missing_ok=True)
        return Result("skip", src, dst, str(exc))
    except (subprocess.CalledProcessError, RuntimeError, OSError, json.JSONDecodeError) as exc:
        tmp.unlink(missing_ok=True)
        return Result("fail", src, dst, describe_error(exc))
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise


def show_path(path: Path, root: Path) -> str:
    try:
        return str(path.relative_to(root))
    except ValueError:
        return str(path)


def main() -> int:
    if hasattr(signal, "SIGPIPE"):
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)  # `thumb | head` exits quietly
    parser = build_parser()
    config = load_config(CONFIG_PATH)
    parser.set_defaults(**config)
    args = parser.parse_args()

    require_tools()

    if args.format not in SUPPORTED_OUTPUTS:
        parser.error(f"format must be one of: {', '.join(SUPPORTED_OUTPUTS)}")
    if args.size < 1:
        parser.error("--size must be >= 1")
    if not 1 <= args.quality <= 100:
        parser.error("--quality must be 1..100")
    if args.samples < 12:
        parser.error("--samples must be >= 12")
    if args.jobs < 0:
        parser.error("--jobs must be >= 0")
    try:
        resolve_video_at(args.video_at, 100.0)
    except ValueError:
        parser.error("--video-at must be 'auto', a percentage like 25%, or seconds like 12.5")

    jobs = min(8, max(1, os.cpu_count() or 1)) if args.jobs == 0 else args.jobs

    def resolve_out(arg: str, base: Path) -> Path:
        p = Path(arg).expanduser()
        return p if p.is_absolute() else base / p

    # Plan: list of (source, destination, display root)
    plan: list[tuple[Path, Path, Path]] = []
    for raw in args.paths:
        target = Path(raw).expanduser().resolve()
        if target.is_dir():
            outdir = resolve_out(args.output or "thumbnails", target)
            for src in iter_media(
                target, args.recursive, outdir, args.include, args.exclude,
                videos=args.videos or args.artwork_only, hidden=args.hidden,
            ):
                dst = output_for(src, target, outdir, args.recursive, args.format, args.suffix)
                plan.append((src, dst, target))
        elif target.is_file():
            outdir = resolve_out(args.output or args.file_output, target.parent)
            dst = output_for(target, target.parent, outdir, False, args.format, args.suffix)
            plan.append((target, dst, target.parent))
        else:
            parser.error(f"no such file or directory: {raw}")

    seen: set[Path] = set()
    plan = [item for item in plan if not (item[0] in seen or seen.add(item[0]))]

    if jobs > 1:
        # we already parallelise across files; avoid ImageMagick oversubscribing CPUs
        os.environ.setdefault("MAGICK_THREAD_LIMIT", "1")

    common = dict(
        outfmt=args.format,
        size=args.size,
        quality=args.quality,
        samples=args.samples,
        prefer_artwork=not args.no_artwork,
        artwork_only=args.artwork_only,
        force=args.force,
        mtime_only=args.mtime_only,
        dry_run=args.dry_run,
        video_at=args.video_at,
        stale_check=args.stale_check,
    )
    roots = {src: root for src, _dst, root in plan}

    counts = {"ok": 0, "dry": 0, "skip": 0, "fail": 0}

    total = len(plan)
    width = len(str(total))

    def report(result: Result) -> None:
        counts[result.status] += 1
        done = sum(counts.values())
        tag = f"[{done:>{width}}/{total}] "
        if result.status == "fail":
            eprint(f"FAIL  {result.src}: {result.reason}")
        elif not args.quiet:
            where = show_path(result.dst, roots[result.src]) if result.dst else ""
            if result.status == "ok":
                note = f" ({result.reason})" if result.reason else ""
                print(f"{tag}OK    {result.src.name} -> {where}{note}", flush=True)
            elif result.status == "dry":
                print(f"{tag}DRY   {result.src.name} -> {where}", flush=True)
            else:
                note = f" ({result.reason})" if result.reason else ""
                print(f"{tag}SKIP  {result.src.name}{note}", flush=True)

    try:
        if jobs == 1 or len(plan) <= 1:
            for src, dst, _root in plan:
                report(process_one(src, dst, **common))
        else:
            with concurrent.futures.ThreadPoolExecutor(max_workers=jobs) as executor:
                future_map = {
                    executor.submit(process_one, src, dst, **common): src
                    for src, dst, _root in plan
                }
                try:
                    for future in concurrent.futures.as_completed(future_map):
                        try:
                            report(future.result())
                        except Exception as exc:  # defensive: worker should convert errors
                            report(Result("fail", future_map[future], reason=str(exc)))
                except KeyboardInterrupt:
                    for f in future_map:
                        f.cancel()
                    raise
    except KeyboardInterrupt:
        eprint("\nInterrupted. Nothing half-written was kept; it is safe to re-run.")
        return 130

    created, skipped, failed, dry = counts["ok"], counts["skip"], counts["fail"], counts["dry"]

    if args.dry_run:
        print(f"Done: {dry} would create, {skipped} skipped, {failed} failed")
    else:
        print(f"Done: {created} created, {skipped} skipped, {failed} failed")

    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
