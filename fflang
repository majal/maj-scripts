#!/usr/bin/env python3
"""
fflang

A multi-language audio and subtitle video muxer for jw.org videos.
Combines a source video (e.g. sign-language), an English subtitle track, and
multiple spoken-language audio tracks into a single multi-stream video.
"""

import argparse
import glob
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path


KNOWN_LANGUAGES = {
    "E": ("eng", "English"),
    "TG": ("tgl", "Tagalog"),
    "CV": ("ceb", "Cebuano"),
    "HV": ("hil", "Hiligaynon"),
    "SA": ("war", "Waray-Waray"),
    "FSL": ("fsl", "Filipino Sign Language"),
    "ASL": ("ase", "American Sign Language"),
    "S": ("spa", "Spanish"),
    "F": ("fra", "French"),
    "P": ("por", "Portuguese"),
    "X": ("deu", "German"),
    "I": ("ita", "Italian"),
    "J": ("jpn", "Japanese"),
    "K": ("kor", "Korean"),
    "CH": ("zho", "Chinese"),
}

def get_lang_meta(code: str) -> tuple[str, str]:
    code_upper = code.upper()
    if code_upper in KNOWN_LANGUAGES:
        return KNOWN_LANGUAGES[code_upper]
    return (code.lower()[:3], code.upper())

def color_print(msg: str, color_code: str = ""):
    if not color_code:
        print(msg)
    else:
        print(f"\033[{color_code}m{msg}\033[0m")

def parse_filename(filepath: Path) -> tuple[str, str, str]:
    """Returns (pre_nolang, res_marker, post)"""
    name = filepath.name
    match = re.search(r'(r\d{3}P)', name)
    if not match:
        raise ValueError(f"Could not find resolution marker (e.g. r720P) in filename: {name}")
    
    res_marker = match.group(1)
    idx = name.find(res_marker)
    
    pre = name[:idx]
    post = name[idx + len(res_marker):]
    
    lang_match = re.match(r'^([A-Za-z0-9-]+_)([A-Z]+)(_.*)?$', pre)
    if not lang_match:
        return pre, res_marker, post
        
    rest = lang_match.group(3) or ""
    pre_nolang = f"{lang_match.group(1)}_{rest}"
    return pre_nolang, res_marker, post

def find_file(directory: Path, pre_nolang: str, lang: str, post: str) -> Path | None:
    if "__" in pre_nolang:
        pre = pre_nolang.replace("__", f"_{lang}_", 1)
    else:
        pre = f"{pre_nolang}{lang}_"
        
    pattern_m60 = str(directory / f"{pre}r*P_m60{post}")
    matches = glob.glob(pattern_m60)
    if matches:
        return Path(matches[0])
        
    pattern_normal = str(directory / f"{pre}r*P{post}")
    matches2 = glob.glob(pattern_normal)
    if matches2:
        return Path(matches2[0])
        
    pattern_loose = str(directory / f"{pre}r*P*")
    matches3 = glob.glob(pattern_loose)
    if matches3:
        for m in matches3:
            if m.endswith(('.mp4', '.m4v', '.mkv')):
                return Path(m)
                
    return None

def main():
    parser = argparse.ArgumentParser(description="Multi-language audio and subtitle video muxer.")
    parser.add_argument("input_file", help="Path to any of the source video files")
    parser.add_argument("--video-lang", default="FSL", help="Video source language code (default: FSL)")
    parser.add_argument("--subs-lang", default="E", help="Subtitles source language code (default: E)")
    parser.add_argument("--audio-langs", default="E,TG,CV,HV,SA", help="Comma-separated audio language codes (default: E,TG,CV,HV,SA)")
    parser.add_argument("--dry-run", action="store_true", help="Print commands without executing them")
    parser.add_argument("--create-singles", action="store_true", help="Also create single-audio language muxes alongside the merged file")
    
    args = parser.parse_args()
    
    if not shutil.which("ffmpeg"):
        color_print("Error: Required program 'ffmpeg' not found.", "31")
        sys.exit(1)
        
    input_path = Path(args.input_file).resolve()
    if not input_path.is_file():
        color_print(f"Error: Not readable: {input_path}", "31")
        sys.exit(1)
        
    try:
        pre_nolang, res_marker, post = parse_filename(input_path)
    except ValueError as e:
        color_print(str(e), "31")
        sys.exit(1)
        
    directory = input_path.parent
    
    # 1. Find Video Source
    src_vid_path = find_file(directory, pre_nolang, args.video_lang, post)
    if not src_vid_path:
        color_print(f"Error: Video source ({args.video_lang}) not found!", "31")
        sys.exit(1)
        
    # 2. Find Subtitles Source
    src_subs_path = find_file(directory, pre_nolang, args.subs_lang, post)
    if not src_subs_path:
        color_print(f"Error: Subtitles source ({args.subs_lang}) not found!", "31")
        sys.exit(1)
        
    audio_langs = [l.strip() for l in args.audio_langs.split(",") if l.strip()]
    
    ff_opts_pre = ["-hide_banner", "-loglevel", "error", "-nostats"]
    ff_opts_post = ["-c", "copy", "-c:s", "mov_text", "-y"]
    
    color_print(">> Finding language files...", "36")
    langs_ok = []
    lang_paths = {}
    
    for lang in audio_langs:
        lang_path = find_file(directory, pre_nolang, lang, post)
        if not lang_path:
            color_print(f"  [{lang}] Not found. Skipping.", "33")
            continue
            
        langs_ok.append(lang)
        lang_paths[lang] = lang_path
        color_print(f"  [{lang}] Found: {lang_path.name}", "32")
        
        if args.create_singles:
            out_name = src_vid_path.name.replace(f"_{args.video_lang}_", f"_{args.video_lang}-{lang}_")
            if out_name == src_vid_path.name:
                out_name = f"single_{lang}_{src_vid_path.name}"
            out_path = directory / out_name
            
            cmd = ["ffmpeg"] + ff_opts_pre + [
                "-i", str(src_vid_path),
                "-i", str(src_subs_path),
                "-i", str(lang_path),
                "-map", "0:v", "-map", "1:s?", "-map", "2:a"
            ] + ff_opts_post + [str(out_path)]
            
            color_print(f"  [{lang}] Muxing single file...", "34")
            if args.dry_run:
                print(" ".join(cmd))
            else:
                res = subprocess.run(cmd)
                if res.returncode != 0:
                    color_print(f"  [{lang}] Failed to mux single file.", "31")
                else:
                    color_print(f"  [{lang}] Single file created.", "32")

    if not langs_ok:
        color_print("Error: No audio language files found to merge.", "31")
        sys.exit(1)

    color_print("\n>> Merging into single multi-stream file...", "36")
    
    cmd = ["ffmpeg"] + ff_opts_pre
    cmd += ["-i", str(src_vid_path), "-i", str(src_subs_path)]
    for lang in langs_ok:
        cmd += ["-i", str(lang_paths[lang])]
        
    cmd += ["-map", "0:v", "-map", "0:a?", "-map", "1:s?"]
    for i in range(len(langs_ok)):
        cmd += ["-map", f"{i+2}:a"]
        
    # Audio metadata
    cmd += ["-metadata:s:a:0", "language=eng", "-metadata:s:a:0", "title=English"]
    
    for i, lang in enumerate(langs_ok):
        iso_code, title = get_lang_meta(lang)
        cmd += [f"-metadata:s:a:{i+1}", f"language={iso_code}"]
        cmd += [f"-metadata:s:a:{i+1}", f"title={title}"]
        
    # Subtitle metadata
    cmd += ["-metadata:s:s:0", "language=eng", "-metadata:s:s:0", "title=English"]
    cmd += ["-disposition:a:0", "default"]
    
    langs_loaded_str = "-".join(langs_ok)
    out_name = src_vid_path.name.replace(f"_{args.video_lang}_", f"_{args.video_lang}-{langs_loaded_str}_")
    if out_name == src_vid_path.name:
         out_name = f"merged_{langs_loaded_str}_{src_vid_path.name}"
    out_path = directory / out_name
    
    cmd += ff_opts_post + [str(out_path)]
    
    if args.dry_run:
        print(" ".join(cmd))
    else:
        res = subprocess.run(cmd)
        if res.returncode == 0:
            color_print(f"✓ Multi-language merge complete: {out_path.name}", "32")
        else:
            color_print("✗ Merge failed", "31")
            sys.exit(1)

if __name__ == "__main__":
    main()
