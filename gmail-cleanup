    return {
        "date_header": plan.date_header,
        "label_ids": list(plan.label_ids),
        "media_parts": [
            {
                "content_id": part.content_id,
                "disposition": part.disposition,
                "filename": part.filename,
                "saved_filename": part.saved_filename,
                "search_token": part.search_token,
                "photos_search_query": photos_search_query(part.search_token),
                "mime_type": part.mime_type,
                "path": list(part.path),
                "planned_output": build_saved_filename(part.search_token, part.filename)
                if part.mime_type != PDF_MIME_TYPE
                else "page images",
                "size_bytes": part.size_bytes,
            }
            for part in plan.media_parts
        ],
        "message_id": plan.message_id,
        "sender": plan.sender,
        "skip_reason": plan.skip_reason,
        "subject": plan.subject,
        "thread_id": plan.thread_id,
    }


def downgrade_request_profile(profile: str) -> str:
    order = list(VALID_REQUEST_PROFILES)
    try:
        index = order.index(profile)
    except ValueError:
        return "conservative"
    if index == 0:
        return order[0]
    return order[index - 1]


def summarize_run(
    query: str,
    backup_dir: Path,
    message_ids: list[str],
    planned: list[PlannedMessage],
    skipped: list[PlannedMessage],
    applied: list[dict[str, object]],
    apply_mode: bool,
) -> dict[str, object]:
    selected_parts = sum(len(plan.media_parts) for plan in planned)
    selected_bytes = sum(part.size_bytes for plan in planned for part in plan.media_parts)
    return {
        "applied": applied,
        "backup_dir": str(backup_dir),
        "candidate_bytes": selected_bytes,
        "candidate_media_parts": selected_parts,
        "candidate_messages": len(planned),
        "inspected_messages": len(message_ids),
        "matched_messages": len(message_ids),
        "messages": [plan_to_dict(plan) for plan in planned],
        "mode": "apply" if apply_mode else "dry-run",
        "query": query,
        "skipped_messages": [plan_to_dict(plan) for plan in skipped],
    }


def render_summary(summary: dict[str, object]) -> str:
    lines = [
        f"Mode: {summary['mode']}",
        f"Query: {summary['query']}",
        f"Backup dir: {summary['backup_dir']}",
        f"Config: {summary['config_path'] or 'none'}",
        f"Matched Gmail messages: {summary['matched_messages']}",
        f"Inspected messages: {summary['inspected_messages']}",
        f"Candidate messages: {summary['candidate_messages']}",
        f"Candidate attachment parts: {summary['candidate_media_parts']}",
        f"Candidate bytes: {human_size(int(summary['candidate_bytes']))}",
    ]
    skipped = summary["skipped_messages"]
    if skipped:
        lines.append(f"Skipped messages: {len(skipped)}")
        for plan in skipped:
            lines.append(
                f"  - {plan['message_id']}: {plan['subject'] or '(no subject)'} "
                f"[{plan['skip_reason']}]"
            )
    for plan in summary["messages"]:
        lines.append(
            f"- {plan['message_id']}: {plan['subject'] or '(no subject)'} "
            f"from {plan['sender'] or '(unknown sender)'}"
        )
        for part in plan["media_parts"]:
            if part["mime_type"] == PDF_MIME_TYPE:
                lines.append(
                    f"    * {part['filename']} -> page images "
                    f"[group token {part['photos_search_query']}] "
                    f"({part['mime_type']}, {human_size(int(part['size_bytes']))})"
                )
            else:
                lines.append(
                    f"    * {part['filename']} -> {part['saved_filename']} "
                    f"[{part['photos_search_query']}] "
                    f"({part['mime_type']}, {human_size(int(part['size_bytes']))})"
                )
    applied = summary["applied"]
    if applied:
        lines.append(f"Applied messages: {len(applied)}")
        for item in applied:
            lines.append(
                f"  - {item['original_message_id']} -> {item['new_message_id']} "
                f"({len(item['attachments'])} file(s), {item['message_backup_folder']}/)"
            )
    exported = summary.get("exported", [])
    if exported:
        lines.append(f"Exported messages: {len(exported)}")
        for item in exported:
            lines.append(
                f"  - {item['original_message_id']} "
                f"({len(item.get('attachments', []))} file(s), {item['message_backup_folder']}/)"
            )
    resumed_exported = summary.get("resumed_exported", [])
    if resumed_exported:
        lines.append(f"Previously exported messages skipped by resume: {len(resumed_exported)}")
        for item in resumed_exported:
            lines.append(
                f"  - {item['original_message_id']} "
                f"({len(item.get('attachments', []))} file(s), {item['message_backup_folder']}/)"
            )
    resumed = summary.get("resumed_applied", [])
    if resumed:
        lines.append(f"Previously applied messages skipped by resume: {len(resumed)}")
        for item in resumed:
            lines.append(
                f"  - {item['original_message_id']} -> {item['new_message_id']} "
                f"({len(item.get('attachments', []))} file(s), {item['message_backup_folder']}/)"
            )
    return "\n".join(lines)


def message_has_only_ignored_sidecars(message: EmailMessage) -> bool:
    attachment_parts = [part for part in message.walk() if is_analyzable_attachment_part(part)]
    return bool(attachment_parts) and all(is_ignored_sidecar_part(part) for part in attachment_parts)


