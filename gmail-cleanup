        "original_message_id": plan.message_id,
        "query": query,
        "sender": plan.sender,
        "settings": settings_checkpoint_payload(settings),
        "subject": plan.subject,
        "thread_id": plan.thread_id,
        "exported_at": exported_at.astimezone(timezone.utc).isoformat(timespec="seconds"),
