def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=Path(sys.argv[0]).name,
        description=(
            "Back up selected Gmail attachments to a local folder, rewrite the message "
            "without those attachments, and keep the email in place by inserting a modified copy."
        ),
    )
    subparsers = parser.add_subparsers(dest="command")

    extract = subparsers.add_parser(
        "extract-media",
        help="Back up selected attachments to a local folder and remove them from the email copy kept in Gmail.",
    )
    extract.add_argument(
        "--preset",
        choices=VALID_PRESETS,
        default=None,
        help="Apply a named cleanup option set such as large-media, office-docs, archives, audio-archive, old-media, or pdf-archive.",
    )
    extract.add_argument("--query", default=None, help="Gmail search query used to find candidate messages.")
    extract.add_argument(
        "--backup-dir",
        type=Path,
        help=(
            "Local directory where extracted media files and the manifest are written. "
            f"Defaults to ${DEFAULT_BACKUP_DIR_ENV} or {DEFAULT_CONFIG_PATH}."
        ),
    )
    extract.add_argument(
        "--max-results",
        type=int,
        default=None,
        help="Maximum number of Gmail search matches to inspect (default: 50; values above 500 are paginated).",
    )
    extract.add_argument(
        "--config",
        type=Path,
        help=(
            "Path to a local TOML config file. "
            f"Defaults to ${DEFAULT_CONFIG_ENV} or {DEFAULT_CONFIG_PATH}."
        ),
    )
    extract.add_argument(
        "--credentials",
        type=Path,
        help=(
            "Path to the Google desktop OAuth client secret JSON. "
            f"Defaults to ${DEFAULT_CREDENTIALS_ENV} or the config file."
        ),
    )
    extract.add_argument(
        "--token-cache",
        type=Path,
        help=(
            "Path to the cached OAuth token JSON. "
            f"Defaults to ${DEFAULT_TOKEN_ENV}, the config file, or {DEFAULT_TOKEN_PATH}."
        ),
    )
    extract.add_argument(
        "--gmail-user",
        default=None,
        help=(
            "Gmail user ID to call the API with. "
            f"Defaults to ${DEFAULT_GMAIL_USER_ENV}, the config file, or me."
        ),
    )
    extract.add_argument(
        "--index-db",
        type=Path,
        help=(
            "Path to the local SQLite Gmail index. "
            f"Defaults to ${DEFAULT_INDEX_DB_ENV}, the config file, or {DEFAULT_INDEX_DB_PATH}."
        ),
    )
    extract.add_argument(
        "--use-index",
        action="store_true",
        help="Use the local Gmail index as a read-through cache for message IDs and raw MIME bytes.",
    )
    extract.add_argument(
        "--apply",
        action="store_true",
        help=(
            "Actually write backup files, insert modified Gmail copies, and move originals to Trash. "
            "Without this flag the command performs a dry run."
        ),
    )
    extract.add_argument(
        "--export-only",
        action="store_true",
        help="Write selected backup files and manifest records, but leave Gmail unchanged.",
    )
    extract.add_argument(
        "--types",
        default=None,
        help=(
            "Comma-separated attachment selectors to extract. "
            f"Supported values: {', '.join(VALID_ATTACHMENT_TYPES)}. "
            "Default: image,video."
        ),
    )
    extract.add_argument(
        "--before-year",
        type=int,
        default=None,
        help="Only select attachments from messages whose Date header is before this year.",
    )
    extract.add_argument(
        "--min-message-bytes",
        type=int,
        default=None,
        help="Only select messages whose selected attachments total at least this many bytes.",
    )
    extract.add_argument(
        "--min-part-bytes",
        type=int,
        default=None,
        help="Only select attachment parts at least this many bytes.",
    )
    extract.add_argument(
        "--readable-folders",
        action="store_true",
        help="Name backup folders as message-id plus a short sanitized subject snippet.",
    )
    extract.add_argument(
        "--embedded-image-dir",
        type=Path,
        help=(
            "Optional second drop directory for images found inside Office/OpenDocument files. "
            f"Defaults to ${DEFAULT_EMBEDDED_IMAGE_DIR_ENV} or embedded_image_dir in config when set."
        ),
    )
    extract.add_argument(
        "--soffice",
        help=(
            "Optional LibreOffice/soffice executable path for legacy Office embedded-image extraction. "
            f"Defaults to ${DEFAULT_SOFFICE_ENV}, soffice in config, or auto-detecting soffice/libreoffice."
        ),
    )
    extract.add_argument(
        "--pdf-mode",
        choices=VALID_PDF_MODES,
        default=None,
        help=(
            "How PDFs are handled when pdf is included in --types: "
            "auto (prefer direct page-image extraction for scanned PDFs, otherwise render pages), "
            "render-pages, extract-images, or backup."
        ),
    )
    extract.add_argument(
        "--pdf-original",
        choices=VALID_PDF_ORIGINAL_RETENTION,
        default=None,
        help=(
            "What to do with the original local PDF after derived outputs are created: "
            "keep, trash, or discard. Ignored when --pdf-mode=backup."
        ),
    )
    extract.add_argument(
        "--pdf-password-mode",
        choices=VALID_PDF_PASSWORD_MODES,
        default=None,
        help=(
            "How password-protected PDFs are handled: "
            "skip leaves the email unchanged and records it for manual review; "
            "infer tries bounded password guesses from the email content first; "
            "low-hanging adds weak bank/card-style patterns such as last4, last6, and ddmmmyyyy."
        ),
    )
    extract.add_argument(
        "--pdf-password-failure-action",
        choices=VALID_PDF_PASSWORD_FAILURE_ACTIONS,
        default=None,
        help=(
            "What to do when a passworded PDF cannot be opened: "
            "skip leaves the email unchanged; trash-original removes the Gmail attachment, "
            "moves the downloaded original PDF to the local OS Trash, and keeps a note in the cleaned email."
        ),
    )
    extract.add_argument(
        "--pdf-password-date-range",
        default=None,
        help=(
            "Inclusive YYYY-YYYY range used for low-hanging ddmmmyyyy PDF password guesses. "
            f"Default: {DEFAULT_PDF_PASSWORD_DATE_RANGE}."
        ),
    )
    extract.add_argument(
        "--pdf-password-family-fail-limit",
        type=int,
        default=None,
        help=(
            "After this many failed password attempts for the same sender/filename family, "
            "skip further cracking attempts for that family. Use 0 to disable. "
            f"Default: {DEFAULT_PDF_PASSWORD_FAMILY_FAIL_LIMIT}."
        ),
    )
    extract.add_argument(
        "--no-pdf-password-family-backoff",
        action="store_true",
        help="Disable the PDF password family failure cache for this run.",
    )
    extract.add_argument(
        "--pdf-render-format",
        choices=VALID_PDF_RENDER_FORMATS,
        default=None,
        help="Rendered PDF page format: auto, png, or jpg. Default: auto.",
    )
    extract.add_argument(
        "--pdf-render-dpi",
        type=int,
        default=None,
        help=f"Render DPI for PDF page images (default: {DEFAULT_PDF_RENDER_DPI}).",
    )
    extract.add_argument(
        "--pdf-text-mode",
        choices=VALID_PDF_TEXT_MODES,
        default=None,
        help=(
            "How much PDF text to retain in the cleaned email: "
            "none keeps only the backup note; native embeds extracted PDF text; "
            "ocr uses OCR text; auto prefers native text and falls back to OCR."
        ),
    )
    extract.add_argument(
        "--audio-mode",
        choices=VALID_AUDIO_MODES,
        default=None,
        help=(
            "How audio attachments are saved: copy keeps the original audio file; "
            "video writes a Google Photos-compatible MP4 with a still black frame; "
            "video-plus-original writes both."
        ),
    )
    extract.add_argument(
        "--empty-after-removal",
        choices=VALID_EMPTY_AFTER_REMOVAL_MODES,
        default=None,
        help=(
            "What to do when removing the selected attachments would leave no message body: "
            "skip leaves the original unchanged; note-only inserts a replacement note message."
        ),
    )
    extract.add_argument(
        "--request-profile",
        choices=VALID_REQUEST_PROFILES,
        default=None,
        help="Inspection request profile: conservative, moderate, or aggressive. Default: moderate.",
    )
    extract.add_argument(
        "--quota-units-per-second",
        type=float,
        default=None,
        help=(
            "Target Gmail quota pacing for this user. Google publishes 250 quota units/second; "
            "profile defaults stay below that to leave room for Gmail's unpublished concurrency guard."
        ),
    )
    extract.add_argument(
        "--progress-format",
        choices=VALID_PROGRESS_FORMATS,
        default=None,
        help="Progress output format on stderr: text or jsonl. Default: text.",
    )
    extract.add_argument(
        "--no-resume",
        action="store_true",
        help="Ignore existing manifest resume records and attempt all matched messages again.",
    )
    extract.add_argument(
        "--audit-labels",
        action="store_true",
        help=(
            "Create/apply default Gmail audit labels: "
            f"{DEFAULT_PROCESSED_LABEL} for cleaned copies and {DEFAULT_REVIEW_LABEL} for skipped originals."
        ),
    )
    extract.add_argument(
        "--label-processed",
        default=None,
        help="Gmail label name to create/apply to inserted cleaned copies after successful apply.",
    )
    extract.add_argument(
        "--label-review",
        default=None,
        help="Gmail label name to create/apply to skipped originals that need manual review.",
    )
    extract.add_argument(
        "-v",
        "--verbose",
        action="count",
        default=0,
        help=(
            "Increase progress output. "
            "-v reports per-message progress, -vv adds file/metadata steps, -vvv adds inspection detail."
        ),
    )
    extract.add_argument(
        "-y",
        "--yes",
        action="store_true",
        help="Accept dependency install prompts automatically.",
    )
    extract.add_argument("--json", action="store_true", help="Print the final summary as JSON.")

    report = subparsers.add_parser(
        "report",
        help="Classify Gmail search matches as actionable, false-positive, or skipped without changing Gmail.",
    )
    report.add_argument(
        "--preset",
        choices=VALID_PRESETS,
        default=None,
        help="Apply a named cleanup option set before reporting.",
    )
    report.add_argument("--query", default=None, help="Gmail search query to classify.")
    report.add_argument("--max-results", type=int, default=None, help="Maximum Gmail search matches to inspect.")
    report.add_argument("--config", type=Path, help=f"Path to local TOML config. Defaults to ${DEFAULT_CONFIG_ENV}.")
    report.add_argument("--credentials", type=Path, help="Path to the Google desktop OAuth client secret JSON.")
    report.add_argument("--token-cache", type=Path, help="Path to the cached OAuth token JSON.")
    report.add_argument("--gmail-user", default=None, help="Gmail user ID to call the API with. Defaults to me.")
    report.add_argument("--gmail-links", action="store_true", help="Include Gmail web links for manual review.")
    report.add_argument(
        "--gmail-web-account",
        default=None,
        help=f"Gmail web account slot used in report links. Defaults to ${DEFAULT_GMAIL_WEB_ACCOUNT_ENV}, config, or {DEFAULT_GMAIL_WEB_ACCOUNT}.",
    )
    report.add_argument("--backup-dir", type=Path, help="Use this backup manifest to annotate exported/completed migration status.")
    report.add_argument("--index-db", type=Path, help=f"Path to the local SQLite Gmail index. Defaults to {DEFAULT_INDEX_DB_PATH}.")
    report.add_argument("--use-index", action="store_true", help="Use the local Gmail index before downloading messages from Gmail.")
    report.add_argument("--offline", action="store_true", help="Use only the local Gmail index. Requires --use-index and never contacts Gmail.")
    report.add_argument("--types", default=None, help="Comma-separated attachment selectors to classify.")
    report.add_argument("--before-year", type=int, default=None, help="Only classify attachments from messages before this year.")
    report.add_argument("--min-message-bytes", type=int, default=None, help="Only count messages whose selected attachments total at least this many bytes.")
    report.add_argument("--min-part-bytes", type=int, default=None, help="Only count selected attachment parts at least this many bytes.")
    report.add_argument("--audio-mode", choices=VALID_AUDIO_MODES, default=None, help="Audio backup output mode used by matching extract-media runs.")
    report.add_argument("--request-profile", choices=VALID_REQUEST_PROFILES, default=None, help="Inspection request profile.")
    report.add_argument("--quota-units-per-second", type=float, default=None, help="Target Gmail quota pacing.")
    report.add_argument("--json", action="store_true", help="Print the report as JSON.")

    index = subparsers.add_parser("index", help="Build or inspect the private local Gmail SQLite index.")
    index_subparsers = index.add_subparsers(dest="index_command")

    index_build = index_subparsers.add_parser("build", help="Cache Gmail search matches and raw MIME locally for faster future passes.")
    index_build.add_argument(
        "--preset",
        choices=VALID_PRESETS,
        default=None,
        help="Apply a named cleanup option set before indexing.",
    )
    index_build.add_argument("--query", default=None, help="Gmail search query to index.")
    index_build.add_argument("--max-results", type=int, default=None, help="Maximum Gmail search matches to index.")
    index_build.add_argument("--config", type=Path, help=f"Path to local TOML config. Defaults to ${DEFAULT_CONFIG_ENV}.")
    index_build.add_argument("--credentials", type=Path, help="Path to the Google desktop OAuth client secret JSON.")
    index_build.add_argument("--token-cache", type=Path, help="Path to the cached OAuth token JSON.")
    index_build.add_argument("--gmail-user", default=None, help="Gmail user ID to call the API with. Defaults to me.")
    index_build.add_argument("--index-db", type=Path, help=f"Path to the local SQLite Gmail index. Defaults to {DEFAULT_INDEX_DB_PATH}.")
    index_build.add_argument("--request-profile", choices=VALID_REQUEST_PROFILES, default=None, help="Inspection request profile.")
    index_build.add_argument("--quota-units-per-second", type=float, default=None, help="Target Gmail quota pacing.")
    index_build.add_argument(
        "--progress-format",
        choices=VALID_PROGRESS_FORMATS,
        default=None,
        help="Progress output format on stderr: text or jsonl. Default: text.",
    )
    index_build.add_argument("-v", "--verbose", action="count", default=0, help="Increase progress output.")
    index_build.add_argument("-y", "--yes", action="store_true", help="Accept dependency install prompts automatically.")
    index_build.add_argument("--json", action="store_true", help="Print the index summary as JSON.")

    index_stats = index_subparsers.add_parser("stats", help="Show local Gmail index size and cached query counts.")
    index_stats.add_argument("--config", type=Path, help=f"Path to local TOML config. Defaults to ${DEFAULT_CONFIG_ENV}.")
    index_stats.add_argument("--index-db", type=Path, help=f"Path to the local SQLite Gmail index. Defaults to {DEFAULT_INDEX_DB_PATH}.")
    index_stats.add_argument("--json", action="store_true", help="Print index stats as JSON.")

    index_analyze = index_subparsers.add_parser("analyze", help="Summarize cached attachment categories from the local Gmail index.")
    index_analyze.add_argument(
        "--preset",
        choices=VALID_PRESETS,
        default=None,
        help="Apply a named cleanup option set before analyzing its cached query.",
    )
    index_analyze.add_argument("--config", type=Path, help=f"Path to local TOML config. Defaults to ${DEFAULT_CONFIG_ENV}.")
    index_analyze.add_argument("--index-db", type=Path, help=f"Path to the local SQLite Gmail index. Defaults to {DEFAULT_INDEX_DB_PATH}.")
    index_analyze.add_argument("--query", default=None, help="Only analyze cached messages for this exact indexed Gmail query.")
    index_analyze.add_argument("--max-results", type=int, default=None, help="Maximum cached messages to analyze.")
    index_analyze.add_argument("--top", type=int, default=20, help="Number of top rows to include in ranked sections.")
    index_analyze.add_argument("--json", action="store_true", help="Print the analysis as JSON.")

    doctor = subparsers.add_parser("doctor", help="Check local gmail-cleanup configuration, tokens, and dependencies.")
    doctor.add_argument("--config", type=Path, help=f"Path to local TOML config. Defaults to ${DEFAULT_CONFIG_ENV}.")
    doctor.add_argument("--backup-dir", type=Path, help="Local backup directory to check.")
    doctor.add_argument("--credentials", type=Path, help="Path to the Google desktop OAuth client secret JSON.")
    doctor.add_argument("--token-cache", type=Path, help="Path to the cached OAuth token JSON.")
    doctor.add_argument("--gmail-user", default=None, help="Gmail user ID to report. Defaults to me.")
    doctor.add_argument("--index-db", type=Path, help=f"Path to the local SQLite Gmail index. Defaults to {DEFAULT_INDEX_DB_PATH}.")
    doctor.add_argument("--json", action="store_true", help="Print diagnostics as JSON.")

    return parser


